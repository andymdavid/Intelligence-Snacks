---
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SignupModal from '@/components/SignupModal.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedAt?: Date | undefined;
  modifiedAt?: Date | undefined;
  canonicalUrl?: string | undefined;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = 'Intelligence Snacks — Ideas for the age of AI',
  description = 'Long conversations about AI, software and business, developed into useful ideas.',
  active = '',
  image = '/social-default.webp',
  type = 'website',
  publishedAt,
  modifiedAt,
  canonicalUrl,
  jsonLd = [],
  noindex = false,
} = Astro.props;
const canonical = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, Astro.site);
const structuredData = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Intelligence Snacks" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content="Intelligence Snacks" />
    <meta property="og:locale" content="en_AU" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@500;600;700&family=Geist:wght@400;500;600;700&family=Jersey+15&display=swap" rel="stylesheet" />
    <title>{title}</title>
    {structuredData.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry).replace(/</g, '\u003c')} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader {active} />
    <main id="main"><slot /></main>
    <SiteFooter />
    <SignupModal />
  </body>
</html>
