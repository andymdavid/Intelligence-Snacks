---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isVisible } from '@/lib/content';
export async function getStaticPaths() { return (await getCollection('people')).map((person) => ({ params: { id: person.id }, props: { person } })); }
const { person } = Astro.props;
const { Content } = await render(person);
const episodes = (await getCollection('episodes')).filter(({ data }) => isVisible(data.status) && data.participants.some(({ id }) => id === person.id));
---
<BaseLayout title={`${person.data.name} — Intelligence Snacks`} description={person.data.shortBio}>
  <header class="person-head page-shell"><div class="person-mark" aria-hidden="true">{person.data.name.split(' ').map((part: string) => part[0]).join('')}</div><div><p class="eyebrow">{person.data.role}</p><h1>{person.data.name}</h1><p>{person.data.shortBio}</p></div></header>
  <section class="person-body page-shell section"><div><Content /></div><aside><p class="eyebrow">Conversations</p>{episodes.map((episode) => <a href={`/episodes/${episode.id}/`}>Episode {episode.data.number}: {episode.data.title} ↗</a>)}</aside></section>
</BaseLayout>
<style>
  .person-head { min-height: 680px; display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 7vw; padding-block: var(--section-space); }
  .person-mark { aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: var(--acid); font-size: clamp(4rem, 10vw, 10rem); font-weight: 600; letter-spacing: -.08em; }
  .person-head h1 { font-size: clamp(4rem, 10vw, 10rem); font-weight: 510; line-height: .82; letter-spacing: -.085em; }
  .person-head div > p:last-child { max-width: 38rem; font-size: 1.2rem; color: var(--muted); }
  .person-body { display: grid; grid-template-columns: 2fr 1fr; gap: 8vw; font-family: Georgia, serif; font-size: 1.3rem; }
  .person-body aside { display: flex; flex-direction: column; gap: 1rem; font-family: var(--font-sans); font-size: .8rem; }
  @media (max-width: 700px) { .person-head, .person-body { grid-template-columns: 1fr; } }
</style>
