---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
const topics = await getCollection('topics');
---
<BaseLayout title="Topics — Intelligence Snacks" description="Explore the central territories in the Intelligence Snacks archive." active="topics">
  <header class="topics-head page-shell"><p class="eyebrow">Explore by topic</p><h1>The territories<br />we keep returning to.</h1><p>Follow the recurring ideas connecting conversations about AI, software and modern business.</p></header>
  <section class="topics-section page-shell section"><div class="topic-grid">{topics.map((topic, index) => <a href={`/topics/${topic.id}/`} style={`--topic:${topic.data.colour}`}><span>{String(index + 1).padStart(2, '0')}</span><h2>{topic.data.name}</h2><p>{topic.data.description}</p><b>Explore topic ↗</b></a>)}</div></section>
</BaseLayout>
<style>
  .topics-head { min-height: 45vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-block: clamp(3rem, 6vw, 6rem); border-bottom: 1px solid var(--line); text-align: center; }
  .topics-head h1 { margin: 0; font-size: var(--type-page); font-weight: 500; line-height: var(--leading-hero); letter-spacing: var(--tracking-hero); }
  .topics-head > p:last-child { max-width: 30.5rem; margin: 1.5rem auto 0; color: var(--text-secondary); }
  .topics-section { background: var(--paper); }
  .topic-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(.65rem, 1vw, 1rem); }
  .topic-grid a { aspect-ratio: 1; display: flex; flex-direction: column; padding: clamp(1.1rem, 1.5vw, 1.5rem); border-radius: 6px; background: var(--topic); transition: transform .2s ease; }
  .topic-grid a:hover { transform: translateY(-4px); }
  .topic-grid span, .topic-grid b { font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }
  .topic-grid h2 { margin: clamp(1.75rem, 3vw, 3rem) 0 .75rem; font-size: clamp(1.35rem, 1.7vw, 1.7rem); line-height: var(--leading-display); letter-spacing: var(--tracking-display); font-weight: 500; }
  .topic-grid p { margin: 0; color: var(--text-secondary); font-size: .9rem; line-height: 1.45; }
  .topic-grid b { margin-top: 1.25rem; }
  @media (max-width: 1100px) { .topic-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 750px) { .topic-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) {
    .topic-grid { grid-template-columns: 1fr; gap: .75rem; }
    .topic-grid a { min-height: 0; aspect-ratio: auto; padding: 1.25rem; }
    .topic-grid h2 { margin: 1.35rem 0 .65rem; font-size: 1.5rem; }
    .topic-grid b { margin-top: 1.5rem; }
  }
</style>
