---
import BaseLayout from '@/layouts/BaseLayout.astro';
const pageUrl = new URL('/about/', Astro.site).href;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'AboutPage', '@id': pageUrl, url: pageUrl, name: 'About Intelligence Snacks', description: 'Long conversations developed into useful ideas.', inLanguage: 'en-AU', isPartOf: { '@id': new URL('/#website', Astro.site).href }, mainEntity: { '@id': new URL('/#organization', Astro.site).href } }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href }, { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl }] }];
---
<BaseLayout title="About — Intelligence Snacks" description="Long conversations developed into useful ideas." {jsonLd}>
  <header class="about-head page-shell"><p class="eyebrow">About the publication</p><h1>The podcast creates room for ideas to be explored. Intelligence Snacks serves the strongest ideas that emerge.</h1></header>
  <section class="about-copy page-shell section"><h2>Depth first.<br />Clarity after.</h2><div><p>Intelligence Snacks is a podcast and connected archive about AI, software, business, work and technological change.</p><p>Each long-form conversation produces distinct, self-contained arguments. We develop those arguments into permanent Snack pages, connect them to the wider body of thinking and share a selection through the weekly email.</p><p>Intelligence Snacks is produced by Other Stuff, an AI software company based in Perth.</p></div></section>
</BaseLayout>
<style>
  .about-head { padding-block: clamp(4rem, 10vw, 10rem); }
  .about-head h1 { max-width: 1450px; font-size: var(--type-page); line-height: var(--leading-hero); letter-spacing: var(--tracking-hero); font-weight: 500; }
  .about-copy { display: grid; grid-template-columns: 1.2fr 1fr; gap: 8vw; }
  .about-copy h2 { font-size: var(--type-feature); line-height: var(--leading-display); letter-spacing: var(--tracking-display); font-weight: 500; }
  .about-copy div { font-family: var(--font-body); font-size: var(--type-body-large); line-height: 1.5; }
  @media (max-width: 700px) { .about-copy { grid-template-columns: 1fr; } }
</style>
