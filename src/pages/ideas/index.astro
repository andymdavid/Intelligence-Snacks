---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pilotIdeas, absolute } from '@/lib/agent-knowledge';
const ideas = pilotIdeas();
const jsonLd = {'@context':'https://schema.org','@type':'CollectionPage',name:'Shared ideas',url:absolute('/ideas/'),mainEntity:{'@type':'ItemList',itemListElement:ideas.map((idea,index)=>({'@type':'ListItem',position:index+1,name:idea.title,url:idea.pageUrl}))}};
---
<BaseLayout title="Shared ideas — Intelligence Snacks" description="Follow recurring ideas across Intelligence Snacks episodes, with source observations, speakers and transcript evidence." {jsonLd} active="graph">
<main class="page-shell ideas-index"><header><p class="eyebrow">Across the conversations</p><h1>Ideas worth following.</h1><p class="intro">A conversation rarely finishes an idea. These five guides bring related discussions together, keeping their different perspectives and original sources in view.</p></header><div class="idea-grid">{ideas.map(idea=><article><p class="eyebrow">{new Set(idea.sources.map(s=>s.observation.episode.id)).size} episodes</p><h2><a href={idea.pageUrl!}>{idea.title}</a></h2><p>{idea.summary}</p><a class="text-link" href={idea.pageUrl!}>Follow the idea ↗</a></article>)}</div><p class="ideas-more">Explore all reviewed themes on the <a href="/graph/">graph</a>, or use the <a href="/for-agents/">public research interface</a>.</p></main>
</BaseLayout>
<style>.ideas-index{padding-block:3rem}.ideas-index header{max-width:56rem;margin-bottom:3rem}.ideas-index h1{font:500 clamp(3rem,7vw,6rem)/1 var(--font-display);letter-spacing:var(--tracking-hero);margin:1rem 0 1.5rem}.intro{font-size:1.2rem;line-height:1.65;color:var(--text-secondary)}.idea-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.idea-grid article{padding:1.75rem;background:var(--paper-raised);border-radius:10px}.idea-grid h2{font:500 2rem/1.1 var(--font-display);letter-spacing:var(--tracking-display)}.idea-grid h2 a:hover{text-decoration:underline}.idea-grid p{line-height:1.65}.ideas-more{margin-top:3rem;line-height:1.6}.ideas-more a{text-decoration:underline}@media(max-width:650px){.idea-grid{grid-template-columns:1fr}.ideas-index{padding-block:2rem}.idea-grid article{padding:1.25rem}}</style>
