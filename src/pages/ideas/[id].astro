---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pilotIdeas, absolute } from '@/lib/agent-knowledge';
export function getStaticPaths() { return pilotIdeas().map(idea=>({params:{id:idea.id},props:{idea}})); }
const {idea}=Astro.props;
const episodes=[...new Map(idea.sources.map(source=>[source.observation.episode.id,source.observation.episode])).values()];
const jsonLd=[{'@context':'https://schema.org','@type':'Article','@id':`${idea.pageUrl}#article`,headline:idea.title,description:idea.summary,url:idea.pageUrl,dateModified:idea.guideUpdatedAt||idea.review.reviewedAt,inLanguage:'en-AU',publisher:{'@id':absolute('/#organization')},author:{'@type':'Organization',name:'Intelligence Snacks',url:absolute('/about/')},citation:episodes.map(e=>({'@type':'PodcastEpisode',name:e.title,url:e.url,episodeNumber:e.number})),about:{'@type':'DefinedTerm',name:idea.title,description:idea.summary}}, {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:absolute('/')},{'@type':'ListItem',position:2,name:'Shared ideas',item:absolute('/ideas/')},{'@type':'ListItem',position:3,name:idea.title,item:idea.pageUrl}]}];
const date=(value:string)=>new Intl.DateTimeFormat('en-AU',{dateStyle:'medium',timeZone:'UTC'}).format(new Date(value));
---
<BaseLayout title={`${idea.title} — Intelligence Snacks`} description={idea.summary} canonicalUrl={idea.pageUrl!} {jsonLd} type="article" modifiedAt={new Date(idea.guideUpdatedAt||idea.review.reviewedAt)} active="graph">
<main class="page-shell idea-page"><nav class="idea-breadcrumb" aria-label="Breadcrumb"><a href="/ideas/">Shared ideas</a><span aria-hidden="true">/</span><span>{idea.title}</span></nav><header><p class="eyebrow">{episodes.length} episodes · {idea.comparisonType==='perspectives'?'Different perspectives':'Recurring discussion'}</p><h1>{idea.title}</h1><p class="idea-summary">{idea.summary}</p><div class="idea-actions"><a href={idea.graphUrl}>Explore on the graph ↗</a><a href={idea.recordUrl}>JSON record ↗</a><a href={`/ideas/${idea.id}.md`}>Plain text ↗</a></div></header>
<section class="reading-notes" aria-label="Reading the discussions">{idea.readingNotes.map(note=><article><h2>{note.heading}</h2><p>{note.text}</p><p class="reading-citations">Sources: {note.observationIds.map(id=><span><a href={`#observation-${id}`}>{idea.sources.find(source=>source.observation.id===`knowledge:${id}`)!.observation.title}</a>{' '}</span>)}</p></article>)}</section>
<section aria-labelledby="discussions-title"><h2 id="discussions-title">How it appears in the conversations</h2><p class="section-intro">These observations share a theme; they retain their own claims and evidence. Read each source in its original context.</p><div class="idea-sources">{idea.sources.map(source=>{
 const node=source.observation;
 const reviewed=node.evidence.filter(e=>source.reviewedEvidenceIds.includes(e.id));
 const evidence=reviewed.find(e=>e.locator==='transcript-turn')||reviewed[0];
 return <article id={`observation-${node.id.slice(10)}`} class="idea-source"><p class="source-meta"><a href={node.episode.url}>Episode {node.episode.number} · {node.episode.title}</a>{node.episode.publishedAt&&<time datetime={node.episode.publishedAt}>{date(node.episode.publishedAt)}</time>}</p><h3>{node.title}</h3><p>{node.summary}</p>{!source.rationale.startsWith("The accepted pilot groups")&&<p class="source-rationale"><strong>Why it connects.</strong> {source.rationale}</p>}{evidence&&<blockquote><p>{evidence.excerpt}</p><footer><cite>{evidence.contributorUrl?<a href={evidence.contributorUrl}>{evidence.speaker}</a>:evidence.speaker||'Speaker not identified'}</cite><a href={evidence.sourceUrl}>{evidence.timestamp?`Read transcript at ${evidence.timestamp} ↗`:'Read source episode ↗'}</a>{evidence.locator==='episode'&&<span class="locator-note">Episode-level citation; exact passage not resolved.</span>}</footer></blockquote>}<div class="source-links"><a href={node.recordUrl}>All evidence &amp; connections ↗</a><a href={node.graphUrl}>Follow this observation ↗</a></div></article>;
})}</div></section>
{idea.relatedIdeas.length>0&&<section class="related-ideas"><h2>Other ideas in these discussions</h2><p>These themes share source observations, rather than asserting agreement or causation.</p><ul>{idea.relatedIdeas.map(other=><li><a href={other.pageUrl||`/graph/?node=${encodeURIComponent(`canonical:${other.id}`)}`}>{other.title}</a></li>)}</ul></section>}
<details class="idea-provenance"><summary>Sources and editorial method</summary><p>Guide prepared by Lara (agent), {date(idea.guideUpdatedAt!)}. Theme grouping reviewed {date(idea.review.reviewedAt)}. Method: agent editorial review. Source observations may be automatically extracted and transcript-validated. This does not imply human review or independent verification of the speakers’ claims.</p><p>The JSON record includes every linked observation, all available excerpts, transcript revision IDs and the evidence IDs reviewed for each grouping. Unresolved passage links point to the source episode; timestamps are never invented.</p><p><a href="/for-agents/">How to retrieve and cite this material</a></p></details>
</main></BaseLayout>
<style>.idea-page{max-width:1120px;padding-block:2rem 3rem}.idea-breadcrumb{display:flex;gap:.75rem;flex-wrap:wrap;font-size:.8rem;margin-bottom:2.5rem;color:var(--text-secondary)}.idea-breadcrumb a{text-decoration:underline}.idea-page header{max-width:58rem;margin-bottom:3rem}.idea-page h1{font:500 clamp(2.6rem,6vw,5rem)/1.02 var(--font-display);letter-spacing:var(--tracking-hero);margin:1rem 0 1.5rem}.idea-summary{font-size:1.25rem;line-height:1.65}.idea-actions,.source-links{display:flex;gap:1.5rem;flex-wrap:wrap;font-size:.8rem;margin-top:1.5rem}.idea-actions a,.source-links a{text-decoration:underline;text-underline-offset:3px}.idea-page h2{font:500 2rem/1.1 var(--font-display);letter-spacing:var(--tracking-display)}.section-intro{max-width:48rem;color:var(--text-secondary);line-height:1.6}.idea-sources{display:grid;gap:1.5rem;margin-top:2rem}.idea-source{padding:clamp(1.25rem,3vw,2.25rem);border-radius:12px;background:var(--paper-raised);scroll-margin-top:80px}.idea-source h3{font:500 1.7rem/1.15 var(--font-display);letter-spacing:var(--tracking-display);margin:1rem 0}.idea-source p{line-height:1.7;overflow-wrap:anywhere}.source-meta{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.75rem;font-size:.8rem;color:var(--text-secondary);margin-top:0}.source-meta a{text-decoration:underline}.source-rationale{font-size:.9rem;color:var(--text-secondary)}.idea-source blockquote{margin:1.5rem 0;padding-left:1.25rem;border-left:2px solid var(--coral)}.idea-source blockquote p{font-size:1rem}.idea-source blockquote footer{display:flex;gap:.5rem 1rem;flex-wrap:wrap;font-size:.8rem;line-height:1.6}.idea-source cite{font-style:normal;font-weight:500}.idea-source blockquote a{text-decoration:underline}.locator-note{flex-basis:100%;color:var(--text-secondary)}.related-ideas{margin-top:3rem}.related-ideas p{line-height:1.6;color:var(--text-secondary)}.related-ideas ul{line-height:1.8;padding-left:1.25rem}.related-ideas a{text-decoration:underline}.idea-provenance{margin-top:3rem;border-top:1px solid var(--line);padding-top:1.25rem;font-size:.85rem;line-height:1.7}.idea-provenance summary{cursor:pointer}.idea-provenance a{text-decoration:underline}@media(max-width:650px){.idea-summary{font-size:1.1rem}.idea-page h2{font-size:1.6rem}.idea-source h3{font-size:1.4rem}.idea-source blockquote{padding-left:.8rem}}.reading-notes{margin:2rem 0 3rem}.reading-notes article{margin-block:2rem}.reading-notes p{line-height:1.75;max-width:58rem}.reading-citations{font-size:.8rem;color:var(--text-secondary)}.reading-citations span{display:inline-block;margin-right:.65rem}.reading-citations a{text-decoration:underline;text-underline-offset:3px}
</style>
