---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SnackVisual from '@/components/SnackVisual.astro';
import { isVisible } from '@/lib/content';

export async function getStaticPaths() {
  return (await getCollection('people')).map((person) => ({ params: { id: person.id }, props: { person } }));
}

interface Props { person: CollectionEntry<'people'>; }
const { person } = Astro.props;
const { Content } = await render(person);
const allEpisodes = await getCollection('episodes');
const episodes = allEpisodes
  .filter(({ data }) => isVisible(data.status) && data.participants.some(({ id }) => id === person.id))
  .sort((a, b) => b.data.number - a.data.number);
const episodeIds = new Set(episodes.map(({ id }) => id));
const episodeNumbers = new Map(episodes.map(({ id, data }) => [id, data.number]));
const snacks = (await getCollection('snacks'))
  .filter(({ data }) => isVisible(data.status) && episodeIds.has(data.sourceEpisode.id))
  .sort((a, b) => {
    const publishedDifference = (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0);
    return publishedDifference || (episodeNumbers.get(b.data.sourceEpisode.id) ?? 0) - (episodeNumbers.get(a.data.sourceEpisode.id) ?? 0);
  });
const isHost = person.id === 'pete-winn' || person.id === 'andy-david';
const visibleEpisodes = isHost ? episodes.slice(0, 3) : episodes;
const visibleSnacks = isHost ? snacks.slice(0, 3) : snacks;
const topics = new Map((await getCollection('topics')).map((topic) => [topic.id, topic]));
const contributorTopicIds = new Set([...episodes.flatMap((entry) => entry.data.themes.map(({ id }) => id)), ...snacks.flatMap((entry) => entry.data.themes.map(({ id }) => id))]);
const contributorTopics = [...contributorTopicIds].map((id) => topics.get(id)).filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
const pageUrl = new URL(`/contributors/${person.id}/`, Astro.site).href;
const pageTitle = person.data.seo?.title ?? `${person.data.name} — Intelligence Snacks`;
const pageDescription = person.data.seo?.description ?? person.data.shortBio;
const pageImage = person.data.seo?.image ?? person.data.image ?? '/social-default.webp';
const sameAs = person.data.socialLinks ? Object.values(person.data.socialLinks).filter(Boolean) : [];
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ProfilePage', '@id': pageUrl, url: pageUrl, inLanguage: 'en-AU',
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  mainEntity: { '@type': 'Person', '@id': `${pageUrl}#person`, name: person.data.name, description: pageDescription, image: new URL(pageImage, Astro.site).href, url: pageUrl, sameAs, affiliation: isHost ? { '@type': 'Organization', name: 'Other Stuff', url: 'https://otherstuff.ai/' } : undefined, knowsAbout: contributorTopics.map((entry) => entry.data.name), subjectOf: episodes.map((entry) => ({ '@type': 'PodcastEpisode', '@id': new URL(`/episodes/${entry.id}/#episode`, Astro.site).href, name: entry.data.title, url: new URL(`/episodes/${entry.id}/`, Astro.site).href })) },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Contributors', item: new URL('/contributors/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: person.data.name, item: pageUrl },
  ],
}];
---

<BaseLayout title={pageTitle} description={pageDescription} image={pageImage} imageWidth={person.data.image ? 640 : 1200} imageHeight={person.data.image ? 640 : 630} canonicalUrl={person.data.seo?.canonicalUrl} type="profile" {jsonLd} active="contributors">
  <header class="contributor-head page-shell">
    <div class="contributor-head__portrait">
      {person.data.image
        ? <img src={person.data.image} alt={person.data.name} width="720" height="720" />
        : <span aria-hidden="true">{person.data.name.slice(0, 2)}</span>}
    </div>
    <div class="contributor-head__copy">
      <p class="eyebrow">{person.data.role}</p>
      <h1>{person.data.name}</h1>
      <p>{person.data.shortBio}</p>
      {person.data.socialLinks && <nav class="social-links" aria-label={`${person.data.name} social profiles`}>
        {person.data.socialLinks.x && <a href={person.data.socialLinks.x} rel="me external" aria-label={`${person.data.name} on X`} title="X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22H17l-4.86-6.35L6.58 22H3.47l7.22-8.25L3.05 2h6.31l4.39 5.8L18.9 2Zm-1.09 17.84h1.72L8.42 4.05H6.58l11.23 15.79Z"/></svg>
        </a>}
        {person.data.socialLinks.linkedin && <a href={person.data.socialLinks.linkedin} rel="me external" aria-label={`${person.data.name} on LinkedIn`} title="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.34 7.43a2.06 2.06 0 1 0 0-4.13 2.06 2.06 0 0 0 0 4.13ZM3.56 20.45h3.56V9H3.56v11.45ZM9.35 9v11.45h3.55v-5.67c0-1.49.28-2.94 2.14-2.94 1.82 0 1.85 1.71 1.85 3.04v5.57h3.56v-6.29c0-3.08-.67-5.45-4.27-5.45-1.73 0-2.9.95-3.37 1.85h-.05V9H9.35Z"/></svg>
        </a>}
        {person.data.socialLinks.nostr && <a href={person.data.socialLinks.nostr} rel="me external" aria-label={`${person.data.name} on Nostr`} title="Nostr">
          <img class="primal-logo" src="/images/primal-logo-white.svg" alt="" aria-hidden="true" width="32" height="32" />
        </a>}
      </nav>}
      {person.data.externalUrl && <a class="follow-link" href={person.data.externalUrl} rel="me external">Website ↗</a>}
    </div>
  </header>

  <section class="contributor-about page-shell section">
    <p class="eyebrow">About</p>
    <div class="prose"><Content /></div>
  </section>

  <section class="conversations page-shell section">
    <div class="section-heading"><h2>{isHost ? 'Latest conversations' : 'Conversations'}</h2><div class="section-heading__meta">{isHost ? <a href="/episodes/">Browse all episodes ↗</a> : <p>{episodes.length} {episodes.length === 1 ? 'episode' : 'episodes'} in the current archive.</p>}</div></div>
    <div class="episode-list">
      {visibleEpisodes.map((episode) => (
        <a href={`/episodes/${episode.id}/`}>
          <span>Episode {episode.data.number}</span><h3>{episode.data.title}</h3><p>{episode.data.summary}</p><b>View episode ↗</b>
        </a>
      ))}
    </div>
  </section>

  {visibleSnacks.length > 0 && <section class="ideas page-shell section">
    <div class="section-heading"><h2>{isHost ? 'Latest ideas' : 'Ideas from the conversation'}</h2><div class="section-heading__meta">{isHost ? <a href="/snacks/">Browse all snacks ↗</a> : <p>Snacks connected through {person.data.name}'s episodes.</p>}</div></div>
    <div class="idea-grid">
      {visibleSnacks.map((snack, index) => {
        const topic = topics.get(snack.data.visualTheme.id);
        return <article>
          <a href={`/snacks/${snack.id}/`} tabindex="-1"><SnackVisual {snack} label={snack.data.editorialTitle ?? topic?.data.name ?? 'Intelligence Snack'} colour={topic?.data.colour ?? '#fe7141'} index={index + 1} compact /></a>
          <p class="eyebrow">{topic?.data.name}</p><h3><a href={`/snacks/${snack.id}/`}>{snack.data.title}</a></h3><p>{snack.data.standfirst}</p>
        </article>;
      })}
    </div>
  </section>}
</BaseLayout>

<style>
  .contributor-head { height: calc(100svh - 58px); display: grid; grid-template-columns: minmax(280px, .85fr) 1.15fr; align-items: center; gap: clamp(3rem, 8vw, 9rem); padding-block: clamp(2rem, 5vh, 4rem); }
  .contributor-head__portrait { width: min(100%, calc(100svh - 58px - clamp(4rem, 10vh, 8rem))); overflow: hidden; aspect-ratio: 1; display: grid; place-items: center; justify-self: center; border-radius: 6px; background: var(--coral); }
  .contributor-head__portrait img { width: 100%; height: 100%; object-fit: cover; }
  .contributor-head__portrait span { font-family: var(--font-display); font-size: var(--type-page); text-transform: uppercase; }
  .contributor-head h1 { margin: 0 0 1.5rem; font-size: var(--type-page); font-weight: 500; line-height: var(--leading-hero); letter-spacing: var(--tracking-hero); }
  .contributor-head__copy > p:not(.eyebrow) { max-width: 38rem; color: var(--text-secondary); font-size: var(--type-body-large); line-height: 1.5; }
  .social-links { display: flex; gap: .6rem; margin-top: 1.5rem; }
  .social-links a { width: 2.6rem; height: 2.6rem; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; transition: background-color .2s ease, color .2s ease; }
  .social-links a:hover { background: var(--ink); color: #fff; }
  .social-links svg { width: 1rem; height: 1rem; fill: currentColor; }
  .social-links .primal-logo { width: 1.1rem; height: 1.1rem; filter: invert(1); transition: filter .2s ease; }
  .social-links a:hover .primal-logo { filter: none; }
  .follow-link { display: inline-block; margin-top: 1.5rem; font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .contributor-about { display: grid; grid-template-columns: 1fr 2fr; gap: 8vw; border-top: 1px solid var(--line); background: var(--paper); }
  .prose { max-width: 48rem; font-size: var(--type-body-large); line-height: 1.55; }
  .section-heading__meta { display: flex; align-items: baseline; gap: 1.5rem; }
  .section-heading__meta p { margin: 0; }
  .section-heading__meta a { flex: none; font-size: .7rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .episode-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .episode-list a { min-height: 320px; display: flex; flex-direction: column; padding: 2rem; border-radius: 6px; background: var(--paper); }
  .episode-list span, .episode-list b { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .episode-list h3 { margin: auto 0 1rem; font-size: var(--type-card); font-weight: 500; line-height: 1.04; }
  .episode-list p { color: var(--text-secondary); line-height: 1.45; }
  .episode-list b { margin-top: 1.5rem; }
  .ideas { background: var(--paper); }
  .idea-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--rail-gap, 1rem); }
  .idea-grid article > a:first-child { display: block; }
  .idea-grid article > .eyebrow { margin-top: 1rem; }
  .idea-grid h3 { margin: .75rem 0; font-size: var(--type-card); font-weight: 500; line-height: 1.04; }
  .idea-grid article > p:last-child { color: var(--text-secondary); line-height: 1.45; }
  @media (max-width: 900px) { .episode-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 800px) { .contributor-head, .contributor-about { grid-template-columns: 1fr; } .contributor-head { height: auto; min-height: calc(100svh - 58px); padding-top: 3rem; } .contributor-head__portrait { width: 100%; max-width: 520px; } .idea-grid { grid-template-columns: repeat(2, 1fr); } .section-heading__meta { align-items: flex-start; flex-direction: column; gap: .75rem; } }
  @media (max-width: 580px) { .episode-list, .idea-grid { grid-template-columns: 1fr; } }
</style>
