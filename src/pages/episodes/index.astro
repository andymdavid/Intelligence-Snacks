---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryVisual from '@/components/StoryVisual.astro';
import { isVisible } from '@/lib/content';
const episodes = (await getCollection('episodes')).filter(({ data }) => isVisible(data.status));
---
<BaseLayout title="Episodes — Intelligence Snacks" description="Long-form conversations about AI, software, business and work." active="episodes">
  <header class="episodes-head page-shell"><p class="eyebrow">The podcast</p><h1>Room for ideas<br />to unfold.</h1><p>Long-form conversations are the source environment for Intelligence Snacks.</p></header>
  <section class="page-shell section episode-list">{await Promise.all(episodes.map(async (episode) => { const topic = await getEntry(episode.data.primaryTopic); return <article><a class="episode-art" href={`/episodes/${episode.id}/`}><StoryVisual label={`Episode ${episode.data.number}`} colour={topic?.data.colour ?? '#9aa7ff'} index={episode.data.number} compact /></a><div><p class="eyebrow">Episode {episode.data.number} · {topic?.data.name}</p><h2><a href={`/episodes/${episode.id}/`}>{episode.data.title}</a></h2><p>{episode.data.summary}</p><a class="text-link" href={`/episodes/${episode.id}/`}>Explore the episode <span>↗</span></a></div></article>; }))}</section>
</BaseLayout>
<style>
  .episodes-head { padding-block: clamp(4rem, 10vw, 10rem); border-bottom: 1px solid var(--line); }
  .episodes-head h1 { font-size: var(--type-page); font-weight: 500; line-height: var(--leading-hero); letter-spacing: var(--tracking-hero); }
  .episodes-head > p:last-child { max-width: 34rem; margin-left: auto; color: var(--text-secondary); }
  .episode-list article { display: grid; grid-template-columns: .8fr 1.2fr; gap: 5vw; align-items: center; }
  .episode-list h2 { font-size: var(--type-feature); font-weight: 500; line-height: var(--leading-display); letter-spacing: var(--tracking-display); }
  .episode-list article > div > p:not(.eyebrow) { max-width: 38rem; color: var(--text-secondary); }
  @media (max-width: 800px) { .episode-list article { grid-template-columns: 1fr; } }
</style>
