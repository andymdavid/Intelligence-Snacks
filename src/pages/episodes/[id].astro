---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SnackCard from '@/components/SnackCard.astro';
import StoryVisual from '@/components/StoryVisual.astro';
import ContributorRow from '@/components/ContributorRow.astro';
import { isVisible } from '@/lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('episodes')).filter(({ data }) => isVisible(data.status));
  return entries.map((episode) => ({ params: { id: episode.id }, props: { episode } }));
}
const { episode } = Astro.props;
const { Content } = await render(episode);
const participants = await Promise.all(episode.data.participants.map((participant) => getEntry(participant)));
const contributors = participants.filter((person): person is NonNullable<typeof person> => Boolean(person));
const topic = await getEntry(episode.data.primaryTopic);
const snacks = (await getCollection('snacks')).filter(({ data }) => isVisible(data.status) && data.sourceEpisode.id === episode.id);
const topics = new Map((await getCollection('topics')).map((entry) => [entry.id, entry]));
const relatedEpisodeTopics = episode.data.relatedTopics.map(({ id }) => topics.get(id)).filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
const transcriptFiles = import.meta.glob('../../content/transcripts/*.txt', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const transcriptSource = episode.data.transcript
  ? Object.entries(transcriptFiles).find(([path]) => path.endsWith(`/${episode.data.transcript}.txt`))?.[1]
  : undefined;
const transcriptTurns = transcriptSource?.trim().split(/\n\s*\n/).flatMap((block) => {
  const match = block.match(/^(.+?) \((\d{2}:\d{2}(?::\d{2})?)\)\n([\s\S]+)$/);
  return match ? [{ speaker: match[1]!, timestamp: match[2]!, text: match[3]!.replace(/\s*\n\s*/g, ' ') }] : [];
}) ?? [];
const timestampSeconds = (timestamp: string) => timestamp.split(':').reverse().reduce((total, part, index) => total + Number(part) * (60 ** index), 0);
const durationSeconds = transcriptTurns.length ? timestampSeconds(transcriptTurns.at(-1)!.timestamp) : undefined;
const isoDuration = durationSeconds ? `PT${Math.floor(durationSeconds / 3600) ? `${Math.floor(durationSeconds / 3600)}H` : ''}${Math.floor((durationSeconds % 3600) / 60)}M${durationSeconds % 60}S` : undefined;
const youtubeId = episode.data.youtubeUrl
  ? new URL(episode.data.youtubeUrl).searchParams.get('v') ?? episode.data.youtubeUrl.split('/').filter(Boolean).pop()
  : undefined;
const pageUrl = new URL(`/episodes/${episode.id}/`, Astro.site).href;
const pageTitle = episode.data.seo?.title ?? `Episode ${episode.data.number}: ${episode.data.title} — Intelligence Snacks`;
const pageDescription = episode.data.seo?.description ?? episode.data.summary;
const pageImage = episode.data.seo?.image ?? episode.data.thumbnail ?? (youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg` : '/social-default.webp');
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'PodcastEpisode', '@id': `${pageUrl}#episode`, name: episode.data.title,
  episodeNumber: episode.data.number, description: pageDescription, url: pageUrl, inLanguage: 'en-AU', duration: isoDuration,
  datePublished: episode.data.originalPublishedAt?.toISOString(), dateModified: episode.data.updatedAt?.toISOString(),
  image: new URL(pageImage, Astro.site).href,
  partOfSeries: { '@id': new URL('/episodes/#podcast', Astro.site).href },
  contributor: contributors.map((person) => ({ '@type': 'Person', '@id': new URL(`/contributors/${person.id}/#person`, Astro.site).href, name: person.data.name, url: new URL(`/contributors/${person.id}/`, Astro.site).href })),
  about: [topic, ...relatedEpisodeTopics].filter((entry): entry is NonNullable<typeof entry> => Boolean(entry)).map((entry) => ({ '@type': 'DefinedTerm', name: entry.data.name, url: new URL(`/topics/${entry.id}/`, Astro.site).href })),
  keywords: [topic, ...relatedEpisodeTopics].filter((entry): entry is NonNullable<typeof entry> => Boolean(entry)).map((entry) => entry.data.name),
  associatedMedia: episode.data.youtubeUrl ? { '@type': 'VideoObject', '@id': `${pageUrl}#video`, name: episode.data.title, description: pageDescription, contentUrl: episode.data.youtubeUrl, embedUrl: `https://www.youtube-nocookie.com/embed/${youtubeId}`, uploadDate: episode.data.originalPublishedAt?.toISOString(), thumbnailUrl: pageImage, duration: isoDuration, inLanguage: 'en-AU' } : undefined,
  potentialAction: episode.data.audioUrl ? { '@type': 'ListenAction', target: episode.data.audioUrl } : undefined,
  hasPart: snacks.map((snack) => ({ '@type': 'Article', '@id': new URL(`/snacks/${snack.id}/#article`, Astro.site).href, name: snack.data.title, url: new URL(`/snacks/${snack.id}/`, Astro.site).href })),
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Episodes', item: new URL('/episodes/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: `Episode ${episode.data.number}`, item: pageUrl },
  ],
}];
---
<BaseLayout title={pageTitle} description={pageDescription} image={pageImage} imageWidth={youtubeId ? 1280 : 1200} imageHeight={youtubeId ? 720 : 630} canonicalUrl={episode.data.seo?.canonicalUrl} type="article" publishedAt={episode.data.originalPublishedAt} modifiedAt={episode.data.updatedAt} {jsonLd} active="episodes">
  <header class="episode-head page-shell">
    <div class="episode-head__meta"><span>Episode {episode.data.number}</span><span>Intelligence Snacks Podcast</span></div>
    <h1>{episode.data.title}</h1>
    <div class="episode-head__details">
      <p class="standfirst">{episode.data.summary}</p>
      <div class="episode-head__source">
        <div><ContributorRow people={contributors} /><p>With {contributors.map((person) => person.data.name).join(', ')}</p></div>
        <p>{snacks.length} ideas developed from this conversation</p>
      </div>
    </div>
  </header>
  <div class="page-shell episode-media">
    {youtubeId
      ? <iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={`Episode ${episode.data.number}: ${episode.data.title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      : <StoryVisual label="Full conversation" colour={topic?.data.colour ?? '#9aa7ff'} index={episode.data.number} />}
    {episode.data.audioUrl && <a class="audio-link" href={episode.data.audioUrl} rel="external">Listen on Spotify <span aria-hidden="true">↗</span></a>}
  </div>
  <section class="episode-intro page-shell section"><p class="eyebrow">About this conversation</p><div><Content /></div></section>
  <section class="page-shell section">
    <div class="section-heading"><h2>Ideas from Episode {episode.data.number}</h2></div>
    <div class="episode-snack-grid">{snacks.map((snack, index) => { const itemTopic = topics.get(snack.data.primaryTopic.id)!; return <SnackCard {snack} topicName={itemTopic.data.name} colour={itemTopic.data.colour} index={index + 1} episodeNumber={episode.data.number} variant="archive" />; })}</div>
  </section>
  {transcriptTurns.length > 0 && (
    <section class="transcript page-shell section">
      <div class="section-heading"><h2>Transcript</h2><p>The complete source conversation, lightly formatted for reading.</p></div>
      <details class="transcript-reader">
        <summary><span>Read full transcript</span><span>{transcriptTurns.length} passages <b aria-hidden="true">+</b></span></summary>
        <div class="transcript-turns">
          {transcriptTurns.map((turn) => (
            <article class="transcript-turn">
              <div><strong>{turn.speaker}</strong>{episode.data.youtubeUrl ? <a href={`${episode.data.youtubeUrl}&t=${timestampSeconds(turn.timestamp)}s`} rel="external" aria-label={`Watch ${turn.speaker} at ${turn.timestamp} on YouTube`}>{turn.timestamp}</a> : <span>{turn.timestamp}</span>}</div>
              <p>{turn.text}</p>
            </article>
          ))}
        </div>
      </details>
    </section>
  )}
</BaseLayout>
<style>
  .episode-head { padding-block: clamp(4rem, 8vw, 8rem); }
  .episode-head__meta { display: flex; justify-content: space-between; gap: 2rem; margin-bottom: 7vw; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; }
  .episode-head h1 { max-width: 1400px; margin-bottom: clamp(2.5rem, 4vw, 4rem); font-size: var(--type-page); font-weight: 500; line-height: var(--leading-hero); letter-spacing: var(--tracking-hero); }
  .episode-head__details { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(280px, 1fr); align-items: start; gap: clamp(3rem, 8vw, 9rem); padding-top: clamp(1.5rem, 2.5vw, 2.5rem); border-top: 1px solid var(--line); }
  .standfirst { max-width: 780px; margin: 0; font-size: clamp(1.25rem, 1.8vw, 1.625rem); line-height: 1.2; letter-spacing: -.02em; }
  .episode-head__source { display: flex; flex-direction: column; gap: 1.5rem; color: var(--muted); font-size: .78rem; }
  .episode-head__source > p { margin: 0; }
  .episode-head__source > div > p { margin: .7rem 0 0; }
  .episode-media { position: relative; padding-block: var(--page-pad); }
  .episode-media :global(.story-visual), .episode-media iframe { width: 100%; height: calc(100svh - 58px - var(--page-pad)); min-height: 0; border: 0; border-radius: var(--radius-small); background: var(--ink); }
  .audio-link { display: flex; width: max-content; align-items: center; gap: .7rem; margin: .75rem 0 0 auto; padding: .9rem 1.1rem; border-radius: var(--radius-small); background: var(--coral); color: var(--ink); font-family: var(--font-display); font-size: .9rem; font-weight: 500; }
  .episode-intro { display: grid; grid-template-columns: 1fr 2fr 1fr; }
  .episode-intro > div { grid-column: 2; font-family: var(--font-body); font-size: var(--type-body-large); line-height: 1.5; }
  .episode-snack-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(.65rem, 1vw, 1rem); row-gap: clamp(3.5rem, 6vw, 6rem); }
  .episode-snack-grid :global(.snack-card--archive) { min-width: 0; background: transparent; }
  .episode-snack-grid :global(.snack-card__visual .story-visual--compact) { height: auto; min-height: 0; aspect-ratio: 3 / 2; }
  .episode-snack-grid :global(.snack-card__body) { padding: 1rem .8rem 0 0; }
  .episode-snack-grid :global(.card-meta) { margin-bottom: .8rem; color: var(--text-muted); font-family: var(--font-body); font-size: .76rem; letter-spacing: 0; text-transform: none; }
  .episode-snack-grid :global(.snack-card h3) { margin-bottom: .7rem; line-height: 1.02; }
  .episode-snack-grid :global(.snack-card p) { font-size: .96rem; line-height: 1.45; }
  .episode-snack-grid :global(.text-link) { padding-top: 1.25rem; }
  .transcript-reader { border-top: 1px solid var(--line); }
  .transcript-reader summary { min-height: 5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; cursor: pointer; list-style: none; font-family: var(--font-display); font-size: clamp(1.15rem, 2vw, 1.65rem); }
  .transcript-reader summary::-webkit-details-marker { display: none; }
  .transcript-reader summary > span:last-child { display: flex; align-items: center; gap: 1.25rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; }
  .transcript-reader summary b { color: var(--ink); font-family: var(--font-body); font-size: 1.5rem; font-weight: 400; transition: transform .2s ease; }
  .transcript-reader[open] summary b { transform: rotate(45deg); }
  .transcript-turns { max-width: 980px; margin-inline: auto; padding: clamp(2rem, 5vw, 5rem) 0; }
  .transcript-turn { display: grid; grid-template-columns: minmax(9rem, .6fr) 2fr; gap: clamp(1.5rem, 4vw, 4rem); padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .transcript-turn > div { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .68rem; }
  .transcript-turn strong { color: var(--ink); font-weight: 600; }
  .transcript-turn a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: .2em; }
  .transcript-turn p { margin: 0; font-size: 1rem; line-height: 1.6; }
  @media (max-width: 900px) { .episode-snack-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .episode-head__details, .episode-intro { grid-template-columns: 1fr; } .episode-head__details { gap: 2.5rem; } .episode-intro > div { grid-column: 1; } .episode-head__meta { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 620px) { .episode-media :global(.story-visual), .episode-media iframe { height: auto; aspect-ratio: 16 / 9; } .audio-link { width: 100%; justify-content: space-between; margin-top: .5rem; } .episode-snack-grid { grid-template-columns: 1fr; } .transcript-reader summary { min-height: 4.5rem; } .transcript-turn { grid-template-columns: 1fr; gap: .75rem; } .transcript-turn > div { justify-content: flex-start; } }
</style>
