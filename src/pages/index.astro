---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SnackCard from '@/components/SnackCard.astro';
import StoryVisual from '@/components/StoryVisual.astro';
import { isVisible } from '@/lib/content';

const snacks = (await getCollection('snacks')).filter(({ data }) => isVisible(data.status));
const episodes = (await getCollection('episodes')).filter(({ data }) => isVisible(data.status));
const newsletters = (await getCollection('newsletters')).filter(({ data }) => isVisible(data.status));
const featured = snacks.find(({ data }) => data.featured) ?? snacks[0];
const remaining = snacks.filter(({ id }) => id !== featured?.id);
const latestEpisode = episodes.find(({ data }) => data.featured) ?? episodes[0];
const latestNewsletter = newsletters[0];
const topics = new Map((await getCollection('topics')).map((topic) => [topic.id, topic]));
const featuredTopic = featured ? topics.get(featured.data.primaryTopic.id) : undefined;
const episodeTopic = latestEpisode ? topics.get(latestEpisode.data.primaryTopic.id) : undefined;
---

<BaseLayout active="latest">
  <section class="home-intro page-shell">
    <p class="eyebrow">AI · Software · Business · Work</p>
    <h1>Ideas for people<br />building what comes next.</h1>
    <div class="home-intro__foot">
      <p>Long conversations, developed into useful ideas. Intelligence Snacks is a podcast, newsletter and growing archive produced by Other Stuff.</p>
      <a href="#latest" class="round-link" aria-label="Explore the latest stories">↓</a>
    </div>
  </section>

  {featured && featuredTopic && (
    <section class="feature page-shell section" id="latest">
      <div class="feature__visual"><a href={`/snacks/${featured.id}/`}><StoryVisual label={featured.data.editorialTitle ?? featuredTopic.data.name} colour={featuredTopic.data.colour} index={64} /></a></div>
      <div class="feature__copy">
        <p class="eyebrow">Featured Snack · {featuredTopic.data.name}</p>
        <h2><a href={`/snacks/${featured.id}/`}>{featured.data.title}</a></h2>
        <p>{featured.data.standfirst}</p>
        <a class="text-link" href={`/snacks/${featured.id}/`}>Read the idea <span>↗</span></a>
      </div>
    </section>
  )}

  <section class="page-shell section">
    <div class="section-heading">
      <h2>Latest snacks</h2>
      <p>Compact, self-contained arguments developed from long-form conversations.</p>
    </div>
    <div class="snack-grid">
      {remaining.slice(0, 6).map((snack, index) => {
        const topic = topics.get(snack.data.primaryTopic.id)!;
        return <SnackCard {snack} topicName={topic.data.name} colour={topic.data.colour} index={index + 2} variant={index === 2 ? 'wide' : 'standard'} />;
      })}
    </div>
    <div class="section-end"><a class="text-link" href="/snacks/">Explore all snacks <span>↗</span></a></div>
  </section>

  {latestEpisode && episodeTopic && (
    <section class="episode-feature page-shell section">
      <div class="section-heading"><h2>Latest episode</h2><p>The full conversation behind the ideas.</p></div>
      <div class="episode-feature__inner">
        <div class="episode-feature__visual"><StoryVisual label={`Episode ${latestEpisode.data.number}`} colour={episodeTopic.data.colour} index={latestEpisode.data.number} /></div>
        <div class="episode-feature__copy">
          <p class="eyebrow">Episode {latestEpisode.data.number} · {episodeTopic.data.name}</p>
          <h3>{latestEpisode.data.title}</h3>
          <p>{latestEpisode.data.summary}</p>
          <a class="text-link" href={`/episodes/${latestEpisode.id}/`}>Explore the episode <span>↗</span></a>
        </div>
      </div>
    </section>
  )}

  {latestNewsletter && (
    <section class="edition-strip page-shell section">
      <p class="eyebrow">Latest edition · No. {String(latestNewsletter.data.editionNumber).padStart(2, '0')}</p>
      <h2>{latestNewsletter.data.title}</h2>
      <div><p>A curated collection of {latestNewsletter.data.snacks.length} ideas from Episode 64.</p><a class="text-link" href={`/newsletters/${latestNewsletter.id}/`}>Read the edition <span>↗</span></a></div>
    </section>
  )}

  <section class="subscribe-panel page-shell section" id="subscribe">
    <div><p class="eyebrow">The weekly edition</p><h2>The strongest ideas, delivered together.</h2></div>
    <form class="subscribe-form">
      <label for="email">Email address</label>
      <div><input id="email" type="email" placeholder="you@example.com" disabled /><button type="button" disabled>Coming soon ↗</button></div>
      <p>Three or four developed ideas from the week’s conversation. No daily noise.</p>
    </form>
  </section>
</BaseLayout>

<style>
  .home-intro { min-height: min(820px, calc(100vh - 92px)); display: flex; flex-direction: column; justify-content: space-between; padding-block: clamp(3rem, 7vw, 6.5rem) 2rem; border-bottom: 1px solid var(--line); }
  .home-intro h1 { max-width: 1400px; margin: 0; font-size: clamp(4rem, 11.2vw, 11.7rem); font-weight: 510; line-height: .8; letter-spacing: -.085em; }
  .home-intro__foot { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .home-intro__foot p { max-width: 38rem; margin: 0; font-size: clamp(1rem, 1.5vw, 1.35rem); color: var(--muted); }
  .round-link { width: 3.5rem; height: 3.5rem; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; }
  .feature { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(320px, .8fr); gap: clamp(2rem, 5vw, 6rem); align-items: center; }
  .feature__copy h2 { font-size: clamp(3rem, 6vw, 7rem); font-weight: 520; line-height: .88; letter-spacing: -.075em; margin-bottom: 2rem; }
  .feature__copy > p:not(.eyebrow) { max-width: 35rem; font-size: 1.1rem; color: var(--muted); }
  .section-end { display: flex; justify-content: flex-end; }
  .episode-feature__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 8rem); align-items: center; }
  .episode-feature__copy h3 { max-width: 720px; font-size: clamp(3rem, 6vw, 6.8rem); font-weight: 520; line-height: .88; letter-spacing: -.075em; }
  .episode-feature__copy > p:not(.eyebrow) { max-width: 38rem; color: var(--muted); font-size: 1.1rem; }
  .edition-strip { display: grid; grid-template-columns: 1fr 2.2fr 1fr; gap: 2rem; align-items: start; }
  .edition-strip h2 { font-size: clamp(3rem, 7vw, 7.5rem); font-weight: 520; line-height: .87; letter-spacing: -.075em; margin: 0; }
  .edition-strip > div p { color: var(--muted); }
  .subscribe-panel { display: grid; grid-template-columns: 1.5fr 1fr; gap: 8vw; background: var(--acid); padding-inline: clamp(1.5rem, 4vw, 5rem); }
  .subscribe-panel h2 { max-width: 800px; font-size: clamp(3rem, 6vw, 6.5rem); line-height: .88; letter-spacing: -.075em; font-weight: 520; }
  .subscribe-form { align-self: end; }
  .subscribe-form label { display: block; margin-bottom: .7rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }
  .subscribe-form > div { display: flex; border-bottom: 1px solid var(--ink); }
  .subscribe-form input { width: 100%; border: 0; background: transparent; padding: 1rem 0; font: inherit; }
  .subscribe-form button { white-space: nowrap; border: 0; background: transparent; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .subscribe-form p { font-size: .8rem; margin-top: 1rem; }
  @media (max-width: 900px) {
    .home-intro { min-height: 660px; }
    .feature, .episode-feature__inner, .edition-strip, .subscribe-panel { grid-template-columns: 1fr; }
  }
</style>
