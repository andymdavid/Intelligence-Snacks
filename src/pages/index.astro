---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StoryVisual from '@/components/StoryVisual.astro';
import EpisodeSnackRail from '@/components/EpisodeSnackRail.astro';
import EmailSignup from '@/components/EmailSignup.astro';
import HeroSnackStack from '@/components/HeroSnackStack.astro';
import HeroTestimonial from '@/components/HeroTestimonial.astro';
import { isVisible } from '@/lib/content';

const snacks = (await getCollection('snacks')).filter(({ data }) => isVisible(data.status));
const episodes = (await getCollection('episodes')).filter(({ data }) => isVisible(data.status));
const featured = snacks.find(({ data }) => data.featured) ?? snacks[0];
const latestEpisode = episodes.find(({ data }) => data.featured) ?? episodes[0];
const topics = new Map((await getCollection('topics')).map((topic) => [topic.id, topic]));
const featuredTopic = featured ? topics.get(featured.data.primaryTopic.id) : undefined;
const episodeTopic = latestEpisode ? topics.get(latestEpisode.data.primaryTopic.id) : undefined;
const people = new Map((await getCollection('people')).map((person) => [person.id, person]));
const heroContributors = ['pete-winn', 'andy-david'].map((id) => people.get(id)).filter((person) => person !== undefined);
const heroSnacks = featured
  ? [
      featured,
      snacks.find(({ id, data }) => id !== featured.id && data.primaryTopic.id === 'agents'),
      snacks.find(({ id, data }) => id !== featured.id && data.primaryTopic.id === 'software-systems'),
    ].filter((snack) => snack !== undefined)
  : [];
const homeUrl = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': homeUrl, url: homeUrl,
  name: 'Intelligence Snacks — Ideas for the age of AI', description: 'Long conversations about AI, software and business, developed into useful ideas.',
  inLanguage: 'en-AU', isPartOf: { '@id': new URL('/#website', Astro.site).href },
  mainEntity: { '@type': 'ItemList', itemListElement: snacks.slice(0, 12).map((snack, index) => ({ '@type': 'ListItem', position: index + 1, name: snack.data.title, url: new URL(`/snacks/${snack.id}/`, Astro.site).href })) },
};
---

<BaseLayout {jsonLd} active="latest">
  <section class="home-intro page-shell">
    <div class="home-intro__content">
      <p class="eyebrow">AI · Software · Business · Work</p>
      <h1>Big Ideas Compound</h1>
      <div class="home-intro__signup">
        <p>For people building and running modern businesses, Intelligence Snacks helps you quickly digest the big ideas emerging from the world of AI, delivered to your inbox each week.</p>
        <EmailSignup id="hero-email" source="homepage-hero" buttonLabel="Send me snacks" />
      </div>
    </div>
    <div class="hero-testimonial-slot"><HeroTestimonial /></div>
    {latestEpisode && heroSnacks.length === 3 && <HeroSnackStack snacks={heroSnacks} topics={topics} contributors={heroContributors} episodeNumber={latestEpisode.data.number} />}
    <a href="#latest" class="scroll-indicator">
      <span>Scroll to explore</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 5v14m0 0 7-7m-7 7-7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  {featured && featuredTopic && (
    <section class="feature page-shell section" id="latest">
      <div class="feature__copy">
        <p class="eyebrow">Featured Snack · {featuredTopic.data.name}</p>
        <h2><a href={`/snacks/${featured.id}/`}>{featured.data.title}</a></h2>
        <p>{featured.data.standfirst}</p>
        <a class="text-link" href={`/snacks/${featured.id}/`}>Read the snack <span>↗</span></a>
      </div>
      <div class="feature__visual"><a href={`/snacks/${featured.id}/`}><StoryVisual label={featured.data.editorialTitle ?? featuredTopic.data.name} colour={featuredTopic.data.colour} index={64} /></a></div>
    </section>
  )}

  <div class="page-shell episode-rails">
    {episodes.map((episode) => {
      const episodeSnacks = snacks.filter(({ data }) => data.sourceEpisode.id === episode.id);
      return episodeSnacks.length > 0 && <EpisodeSnackRail {episode} snacks={episodeSnacks} {topics} />;
    })}
  </div>

  {latestEpisode && episodeTopic && (
    <section class="episode-feature page-shell section">
      <div class="section-heading"><h2>Latest episode</h2><a class="archive-link" href="/episodes/">View all episodes ↗</a></div>
      <div class="episode-feature__inner">
        <div class="episode-feature__visual"><StoryVisual label={`Episode ${latestEpisode.data.number}`} colour={episodeTopic.data.colour} index={latestEpisode.data.number} /></div>
        <div class="episode-feature__copy">
          <p class="eyebrow">Episode {latestEpisode.data.number} · {episodeTopic.data.name}</p>
          <h3>{latestEpisode.data.title}</h3>
          <p>{latestEpisode.data.summary}</p>
          <a class="text-link" href={`/episodes/${latestEpisode.id}/`}>Explore the episode <span>↗</span></a>
        </div>
      </div>
    </section>
  )}

  <section class="subscribe-panel page-shell section" id="subscribe">
    <div><p class="eyebrow">Weekly Intelligence</p><h2>Get next week’s<br />Intelligence Snacks</h2></div>
    <div class="subscribe-form">
      <p class="subscribe-form__label">Email address</p>
      <EmailSignup id="footer-email" source="homepage-footer" class="email-signup--panel" />
      <p>A handful of snacks from each week’s podcast.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-intro { position: relative; min-height: max(760px, calc(100vh - 58px)); display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(26rem, .92fr); align-items: center; gap: clamp(3rem, 6vw, 8rem); padding-block: clamp(3rem, 6vw, 6rem); }
  .home-intro__content { display: grid; align-self: center; align-content: center; gap: clamp(1.5rem, 3.2vh, 2.6rem); min-width: 0; transform: translateY(-5%); }
  .home-intro__content > .eyebrow { margin-bottom: 0; }
  .home-intro h1 { max-width: 1400px; margin: 0; font-size: clamp(3.125rem, 7.8vw, 7rem); font-weight: 700; line-height: var(--leading-hero); letter-spacing: -.04em; }
  .home-intro__signup { width: min(100%, 38rem); display: grid; gap: 1.25rem; }
  .home-intro__signup > p { max-width: 38rem; margin: 0; font-size: var(--type-body-large); color: var(--text-primary); }
  .hero-testimonial-slot { position: absolute; left: calc(var(--page-pad) - max(0px, (100vw - 1600px) / 2)); bottom: 2rem; }
  .scroll-indicator { position: absolute; left: 50%; bottom: 1rem; display: flex; flex-direction: column; align-items: center; gap: .25rem; color: var(--ink); transform: translateX(-50%); }
  .scroll-indicator span { font-family: var(--font-mono); font-size: .75rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .scroll-indicator svg { width: 1rem; height: 1rem; }
  .feature { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 6vw, 8rem); align-items: center; }
  .feature, .episode-feature { min-height: 100vh; min-height: 100svh; border-bottom: 0; background: var(--paper-raised); box-shadow: 0 0 0 100vmax var(--paper-raised); clip-path: inset(0 -100vmax); }
  .feature__copy { min-width: 0; }
  .feature__copy h2 { max-width: 760px; font-size: var(--type-feature); font-weight: 500; line-height: var(--leading-display); letter-spacing: var(--tracking-display); margin-bottom: 2rem; }
  .feature__copy > p:not(.eyebrow) { max-width: 35rem; font-size: var(--type-body-large); color: var(--text-primary); }
  .feature__visual { min-width: 0; }
  .feature__visual :global(.story-visual),
  .episode-feature__visual :global(.story-visual) {
    min-height: 0;
    aspect-ratio: 3 / 2;
  }
  .episode-rails { border-bottom: 0; }
  .episode-rails :global(.episode-snacks:last-child) { border-bottom: 0; }
  .episode-feature__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 8rem); align-items: center; }
  .archive-link { font-family: var(--font-mono); font-size: .7rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .episode-feature__copy h3 { max-width: 720px; margin-bottom: 2rem; font-size: var(--type-feature); font-weight: 500; line-height: var(--leading-display); letter-spacing: var(--tracking-display); }
  .episode-feature__copy > p:not(.eyebrow) { max-width: 38rem; color: var(--text-primary); font-size: var(--type-body-large); }
  .subscribe-panel { display: grid; grid-template-columns: 1.5fr 1fr; align-items: center; gap: 8vw; background: var(--coral); padding-inline: clamp(1.5rem, 4vw, 5rem); }
  .subscribe-panel h2 { max-width: 800px; font-size: var(--type-feature); line-height: var(--leading-display); letter-spacing: var(--tracking-display); font-weight: 500; }
  .subscribe-form { align-self: center; }
  .subscribe-form__label { margin-bottom: .7rem; font-family: var(--font-mono); font-size: var(--type-label); text-transform: uppercase; letter-spacing: -.03em; }
  .subscribe-form > p:last-child { font-size: .8rem; margin-top: .5rem; }
  @media (max-width: 1050px) {
    .home-intro { min-height: 660px; grid-template-columns: 1fr; }
    .home-intro :global(.snack-stack) { display: none; }
    .hero-testimonial-slot { position: static; margin-top: .35rem; }
    .scroll-indicator { display: none; }
  }
  @media (max-width: 900px) {
    .feature, .episode-feature__inner, .subscribe-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .home-intro { min-height: calc(100svh - 58px); display: flex; flex-direction: column; justify-content: center; padding-block: 4rem 8rem; }
    .home-intro__content { width: 100%; transform: translateY(-2vh); }
    .hero-testimonial-slot { position: absolute; right: var(--page-pad); bottom: 1.5rem; left: var(--page-pad); margin: 0; }
    .subscribe-form :global(.email-signup__controls) { flex-direction: column; }
    .subscribe-form :global(.email-signup button) { width: 100%; }
  }
</style>
