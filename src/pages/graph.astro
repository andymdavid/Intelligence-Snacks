---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { canonicalPublicGraph } from '@/lib/public-graph-data';
import { buildKnowledgeModel } from '@/lib/graph-model';
const data = canonicalPublicGraph();
const raw = buildKnowledgeModel(data);
const model = {nodes:raw.nodes, allConnections:raw.links.map((link:any,index:number)=>({...link,id:`public:${index}`,sourceId:link.source,targetId:link.target,relationshipType:link.type,explanation:link.note||''}))};
const episodes=raw.nodes.filter((node:any)=>node.kind==='episode');
const serialise=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
---
<BaseLayout title="Graph — Intelligence Snacks" description="Explore the archive through its ideas, conversations and source evidence." active="graph">
  <header class="explorer-heading page-shell">
    <div><p class="eyebrow">The living archive</p><h1>Follow the ideas.</h1></div>
    <p>One conversation leads to another.<br />Find an idea. See where it takes you.</p>
  </header>
  <section class="explorer page-shell" aria-label="Explore the archive">
    <div class="explorer-bar">
      <form role="search" onsubmit="return false" class="explorer-search">
        <label for="explorer-search" class="visually-hidden">Find an idea, episode or person</label>
        <span aria-hidden="true">⌕</span><input id="explorer-search" type="search" placeholder="Find an idea, episode or person" autocomplete="off" aria-controls="explorer-results" />
      </form>
      <div class="explorer-bar-actions"><button type="button" class="text-link" data-list-toggle aria-expanded="false" aria-controls="explorer-index">Browse the archive ↗</button></div>
    </div>
    <div class="explorer-stage">
      <div class="explorer-map" data-explorer-map role="region" aria-label="Interactive archive map. Drag to pan; use zoom controls. Search or browse the archive for keyboard access.">
        <svg data-explorer-svg role="group" aria-label="All published nodes arranged around their source episodes"></svg>
        <div class="explorer-caption"><span class="eyebrow" data-map-mode>Across the archive</span><span data-map-count>{raw.nodes.length} nodes · {episodes.length} episodes</span></div>
        <p class="explorer-hint" data-map-hint>Select a conversation to begin</p>
        <div class="explorer-controls"><button type="button" data-overview>↖ Overview</button><div><button type="button" data-zoom="1.35" aria-label="Zoom in">+</button><button type="button" data-zoom="0.74" aria-label="Zoom out">−</button></div></div>
        <div class="explorer-tooltip" data-tooltip hidden></div>
      </div>
      <aside class="explorer-detail" data-explorer-detail aria-labelledby="explorer-detail-title" hidden>
        <div class="explorer-detail-actions"><button type="button" data-back>← Back</button><button type="button" data-close aria-label="Close details">×</button></div>
        <div data-detail-content></div>
      </aside>
    </div>
    <div class="explorer-footnote"><p>Colour groups source episodes. Lines show recorded connections; proximity alone does not imply a relationship.</p><span role="status" aria-live="polite" data-explorer-status>Scroll to zoom · drag to explore</span></div>
    <section id="explorer-index" class="explorer-index" aria-labelledby="explorer-index-title" hidden>
      <div class="section-heading"><h2 id="explorer-index-title">Find your next idea.</h2><p data-result-count>{raw.nodes.length} records in the published archive</p></div>
      <ul id="explorer-results">{raw.nodes.map((node:any)=><li data-index-node={node.id}><a href={node.href||'https://intelligencesnacks.com/graph/'} data-pick={node.id}><span class="eyebrow">{node.episodeNumber?`Episode ${node.episodeNumber} · `:''}{node.kind==='canonical'?'Reviewed shared concept':node.kind}</span><strong>{node.title}</strong><span>{node.summary}</span><span aria-hidden="true">↗</span></a></li>)}</ul>
    </section>
    <noscript><style>#explorer-index[hidden]{display:block!important}.explorer-stage{display:none}</style><p>Browse the archive below. Enable JavaScript to explore the interactive map.</p></noscript>
  </section>
</BaseLayout>
<script id="knowledge-data" type="application/json" is:inline set:html={serialise(model)}></script>
<script>
import { initialiseExplorer } from '../lib/graph-explorer';
initialiseExplorer();
</script>
<style is:global>
.explorer-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-block:2.5rem 2rem}.explorer-heading .eyebrow{margin:0 0 1rem}.explorer-heading h1{font:500 clamp(3rem,5.5vw,5.5rem)/.95 var(--font-display);letter-spacing:var(--tracking-hero);margin:0}.explorer-heading>p{font-size:var(--type-body);color:var(--text-secondary);margin:0;line-height:1.5}
.explorer{padding-bottom:3rem}.explorer [hidden]{display:none!important}.explorer-bar{border-block:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:.65rem}.explorer-search{display:flex;align-items:center;gap:.8rem;flex:1;max-width:34rem}.explorer-search>span{font-size:1.7rem}.explorer-search input{width:100%;min-width:0;padding:.7rem 0;border:0;border-radius:0;background:transparent;font:400 1rem var(--font-body);color:var(--ink)}.explorer-bar-actions{display:flex;align-items:center;gap:1.5rem}.explorer-bar .text-link{font-size:.7rem;min-height:44px;display:flex;align-items:center;white-space:nowrap}
.explorer-stage{scroll-margin-top:80px;position:relative;display:grid;grid-template-columns:minmax(0,1fr);border-bottom:1px solid var(--line)}.explorer-map{position:relative;min-width:0;height:clamp(480px,73dvh,920px);overflow:hidden;background:var(--paper);touch-action:none}.explorer-map svg{display:block;width:100%;height:100%;cursor:grab}.explorer-map svg:active{cursor:grabbing}.explorer-map [data-node]{cursor:pointer}.explorer-map [data-node]:focus{outline:none}.explorer-map [data-node]:focus circle{stroke:var(--ink);stroke-width:3}.explorer-caption{position:absolute;top:1.25rem;left:0;pointer-events:none;display:flex;flex-direction:column;gap:.5rem}.explorer-caption>[data-map-count]{font:400 .7rem var(--font-mono);color:var(--text-muted)}.explorer-hint{position:absolute;left:0;bottom:1.4rem;margin:0;font:400 .75rem var(--font-mono);color:var(--text-muted);pointer-events:none}.explorer-controls{position:absolute;right:0;bottom:1.25rem;display:flex;align-items:end;gap:.7rem}.explorer-controls button,.explorer-detail-actions button{border:1px solid var(--line);background:var(--paper);color:var(--ink);font:400 .75rem var(--font-mono);min-height:44px;cursor:pointer;padding:.65rem 1rem;border-radius:var(--radius-small)}.explorer-controls>div{display:flex;flex-direction:column}.explorer-controls [data-zoom]{font:400 1.4rem var(--font-body);width:44px;padding:0}.explorer-controls button:hover,.explorer-detail-actions button:hover{background:var(--paper-raised)}.explorer-tooltip{position:absolute;z-index:3;max-width:260px;padding:.6rem .8rem;background:var(--ink);color:var(--paper);font-size:.8rem;pointer-events:none;border-radius:var(--radius-small)}
.explorer-stage.has-selection{grid-template-columns:minmax(0,1fr) 370px}.explorer-detail{min-width:0;max-height:clamp(480px,73dvh,920px);overflow:auto;border-left:1px solid var(--line);padding:1.25rem 0 1.5rem 1.5rem;background:var(--paper)}.explorer-detail-actions{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.75rem}.explorer-detail-actions button{border:0;padding:0 .5rem}.explorer-detail-actions [data-close]{font-size:1.6rem}.explorer-detail h2{font:500 2rem/1.05 var(--font-display);letter-spacing:var(--tracking-display);margin:.8rem 0 1rem;overflow-wrap:anywhere}.explorer-detail h2:focus{outline:none}.explorer-detail h3{font:500 1.2rem var(--font-display);margin:1.8rem 0 .6rem}.explorer-detail p{font-size:.9rem;line-height:1.6}.explorer-detail .detail-summary{font-size:1rem}.explorer-detail .detail-actions{display:flex;gap:1.2rem;align-items:center;flex-wrap:wrap;padding:1rem 0;border-block:1px solid var(--line)}.explorer-detail .text-link{font-size:.65rem;min-height:44px}.explorer-detail .connection-list{list-style:none;padding:0;margin:0}.connection-list li{border-bottom:1px solid var(--line);padding:.9rem 0}.connection-list button{display:block;background:none;border:0;text-align:left;padding:0;color:var(--ink);font:500 1rem/1.35 var(--font-display);cursor:pointer;text-decoration:underline;text-underline-offset:3px}.connection-list .eyebrow{display:block;font-size:.6rem;margin:0 0 .5rem;color:var(--text-muted)}.connection-list p{font-size:.8rem;margin:.5rem 0 0}.explorer-detail blockquote{border-left:2px solid var(--coral);padding-left:1rem;margin:1.2rem 0;font-size:.9rem;line-height:1.65}.explorer-detail blockquote cite{display:block;font-style:normal;font-size:.75rem;color:var(--text-muted);margin:.6rem 0}.explorer-detail a{overflow-wrap:anywhere}.explorer-detail blockquote a{font-size:.8rem;text-decoration:underline}.explorer-footnote{display:flex;justify-content:space-between;gap:2rem;padding-block:.75rem;color:var(--text-muted);font:400 .65rem/1.6 var(--font-mono)}.explorer-footnote p{margin:0;max-width:49rem}.explorer-footnote>span{white-space:nowrap}.explorer-index{padding-top:2rem}.explorer-index>ul{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:0 2.5rem;max-height:650px;overflow:auto}.explorer-index li>a{position:relative;display:flex;flex-direction:column;gap:.6rem;padding:1.4rem 2rem 1.4rem 0;border-top:1px solid var(--line);text-decoration:none}.explorer-index strong{font:500 1.4rem/1.15 var(--font-display);letter-spacing:var(--tracking-display)}.explorer-index li>a>span:nth-last-child(2){color:var(--text-secondary);font-size:.85rem;line-height:1.5}.explorer-index li>a>span:last-child{position:absolute;right:.25rem;top:1.4rem}.explorer-index .eyebrow{font-size:.6rem}.explorer button:focus-visible,.explorer a:focus-visible,.explorer input:focus-visible{outline:2px solid var(--coral);outline-offset:3px}
@media(max-width:900px){.explorer-stage.has-selection{grid-template-columns:minmax(0,1fr) 320px}.explorer-heading>p{max-width:16rem}.explorer-bar-actions{gap:1rem}.explorer-bar-actions a{display:none}}
@media(max-width:650px){.explorer-heading{display:block;padding-top:2rem}.explorer-heading>p{max-width:none;margin-top:1.2rem}.explorer-heading>p br{display:none}.explorer-bar{flex-wrap:wrap;gap:0}.explorer-search{flex-basis:100%;max-width:none}.explorer-bar-actions{width:100%;justify-content:space-between}.explorer-bar-actions a{display:flex}.explorer-map{height:62dvh;min-height:430px}.explorer-stage.has-selection{display:block}.explorer-stage.has-selection .explorer-map{height:45dvh;min-height:280px}.explorer-detail{border-left:0;border-top:1px solid var(--line);padding:1rem 0;max-height:60dvh;overscroll-behavior:contain}.explorer-detail-actions{margin-bottom:.6rem}.explorer-detail h2{font-size:1.75rem}.explorer-hint{max-width:45%;font-size:.6rem;bottom:1.25rem}.explorer-caption{top:1rem}.explorer-caption .eyebrow{font-size:.65rem}.explorer-footnote{display:block}.explorer-footnote>span{display:block;margin-top:.6rem}.explorer-index>ul{grid-template-columns:1fr}.explorer-controls{gap:.4rem}}
</style>
