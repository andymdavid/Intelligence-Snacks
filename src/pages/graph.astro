.explorer-concepts>div{flex-wrap:wrap;max-height:20rem;overflow:auto}.explorer-search-status:empty{display:none}.explorer-map{height:clamp(520px,78dvh,1100px)}
.explorer-stage:fullscreen,.explorer-stage.is-fullscreen{width:100%;height:100dvh;background:var(--paper);padding:1rem;box-sizing:border-box;border:0}.explorer-stage.is-fullscreen{position:fixed;inset:0;z-index:1000}.explorer-stage:fullscreen .explorer-map,.explorer-stage.is-fullscreen .explorer-map{height:100%;min-height:0}.explorer-stage:fullscreen .explorer-detail,.explorer-stage.is-fullscreen .explorer-detail{max-height:100%;padding-right:1rem}
@media(max-width:650px){.explorer-heading>p{display:none}.explorer-map{height:72dvh;min-height:430px}.explorer-controls{gap:.25rem}.explorer-controls button{padding:.5rem}.explorer-hint{bottom:auto;top:3rem;max-width:80%}.explorer-stage:fullscreen .explorer-detail,.explorer-stage.is-fullscreen .explorer-detail{padding:1rem;min-height:0}}
.explorer-controls [data-fullscreen],.explorer-controls [data-overview]{width:44px;height:44px;padding:0;display:grid;place-items:center;flex-shrink:0}.explorer-controls button svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;cursor:inherit}.explorer-controls [data-collapse-icon]{display:none}.explorer-controls [aria-pressed="true"] [data-expand-icon]{display:none}.explorer-controls [aria-pressed="true"] [data-collapse-icon]{display:block}

.explorer-search-icon{width:21px;height:21px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;color:var(--text-secondary)}
