---
import BaseLayout from '@/layouts/BaseLayout.astro';
import KnowledgeMix from '@/components/KnowledgeMix.astro';
import SharedIdeaReview from '@/components/SharedIdeaReview.astro';
import registry from '@/data/graph-concepts.json';
import audit from '@/data/graph-shared-review.json';
import { pilotIdeaIds } from '@/lib/agent-knowledge';
import {sharedReviewCoverage} from '@/lib/graph-shared-review';
import { canonicalPublicGraph } from '@/lib/public-graph-data';
import { buildKnowledgeModel, buildTopicModel } from '@/lib/graph-model';
const data = canonicalPublicGraph();
const raw = buildKnowledgeModel(data);
for (const node of raw.nodes) if (node.kind === "canonical" && pilotIdeaIds.includes(node.id.slice(10))) node.readingHref = `/ideas/${node.id.slice(10)}/`;
const coverage=sharedReviewCoverage(data,registry,audit);
const model = {nodes:raw.nodes, allConnections:raw.links.map((link:any,index:number)=>({...link,id:`public:${index}`,sourceId:link.source,targetId:link.target,relationshipType:link.type,explanation:link.note||''}))};
const topics = buildTopicModel(data);
const membership = Object.fromEntries(topics.map((topic:any) => {
  const ids = new Set([topic.id,...topic.children.map((child:any)=>child.id)]);
  return [topic.id,[...new Set(data.topicIndex.passages.filter((passage:any)=>ids.has(passage.primaryTopicId)).map((passage:any)=>passage.episodeId))]];
}));
const classified = data.topicIndex.analyses.reduce((sum:number,item:any)=>sum+item.classifiedWordCount,0);
const totalWords = data.topicIndex.analyses.reduce((sum:number,item:any)=>sum+item.totalWordCount,0);

const serialise=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
---
<BaseLayout title="Graph — Intelligence Snacks" description="Explore the archive through its ideas, conversations and source evidence." active="graph">
  <header class="explorer-heading page-shell">
    <div><p class="eyebrow">The living archive</p><h1>Follow the ideas.</h1></div>
    <p>One conversation leads to another.<br />Find an idea. See where it takes you.</p>
  </header>
  <section class="explorer page-shell" aria-label="Explore the archive">
    <div class="explorer-bar">
      <form role="search" onsubmit="return false" class="explorer-search">
        <label for="explorer-search" class="visually-hidden">Find an idea, episode or person</label>
        <svg class="explorer-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input id="explorer-search" type="search" placeholder="Find an idea, episode or person" autocomplete="off" aria-controls="explorer-results" aria-describedby="explorer-search-status" />
      </form>
      <div class="explorer-bar-actions"><label class="explorer-topic"><span class="visually-hidden">Filter by source episode topic</span><select data-topic-filter aria-label="Focus map and results by source episode topic"><option value="">All topics</option>{topics.map((topic:any)=><option value={topic.id}>{topic.name}</option>)}</select></label><button type="button" class="text-link" data-list-toggle aria-expanded="false" aria-controls="explorer-index">Browse the archive ↗</button></div>
    </div>
    <p id="explorer-search-status" role="status" aria-live="polite" data-search-status class="explorer-search-status"></p>
    <section id="explorer-index" class="explorer-index" aria-labelledby="explorer-index-title" hidden>
      <div class="section-heading"><h2 id="explorer-index-title">Find your next idea.</h2><p data-result-count>{raw.nodes.length} records in the published archive</p></div>
      <ul id="explorer-results">{raw.nodes.map((node:any)=><li data-index-node={node.id}><a href={node.href||'https://intelligencesnacks.com/graph/'} data-pick={node.id}><span class="eyebrow">{node.episodeNumber?`Episode ${node.episodeNumber} · `:''}{node.kind==='canonical'?'Reviewed shared concept':node.kind}</span><strong>{node.title}</strong><span>{node.summary}</span><span aria-hidden="true">↗</span></a></li>)}</ul>
    </section>
    <div class="explorer-tools">
      <button type="button" class="text-link" data-concepts-toggle aria-expanded="false" aria-controls="shared-ideas">Shared ideas</button>
      <button type="button" class="text-link" data-clear-topic hidden>Clear topic</button>

    </div>
    <nav id="shared-ideas" class="explorer-concepts" aria-label="Shared ideas" hidden><div>{raw.nodes.filter((node:any)=>node.kind==='canonical').map((node:any)=><button type="button" data-concept-pick={node.id} aria-pressed="false">{node.title}<span>{node.episodeCount} episodes</span></button>)}</div><p data-concept-empty hidden>No shared ideas in this topic yet. Try another topic.</p></nav>
    <div class="explorer-stage" id="graph-stage">
      <div class="explorer-map" data-explorer-map role="region" aria-label="Interactive archive map. Drag to pan; use zoom controls. Search or browse the archive for keyboard access.">
        <svg data-explorer-svg role="group" aria-label="All published nodes arranged around their source episodes"></svg>
        <div class="explorer-caption"><span class="visually-hidden" data-map-mode></span><span data-map-count class="visually-hidden">{raw.nodes.length} nodes · archive</span></div>
        <p class="explorer-hint" data-map-hint>Select a shared idea · zoom in for episode labels</p>
        <div class="explorer-controls"><details class="explorer-options"><summary aria-label="Map options" title="Map options"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 3h4l.6 2.3 2 .9 2.2-.7 2 3.5-1.6 1.7v2.6l1.6 1.7-2 3.5-2.2-.7-2 .9L14 21h-4l-.6-2.3-2-.9-2.2.7-2-3.5 1.6-1.7v-2.6L3.2 9l2-3.5 2.2.7 2-.9L10 3Z"/><circle cx="12" cy="12" r="3"/></svg></summary><div>
        <label><input type="checkbox" data-source-links /> Episode &amp; speaker links</label>
        <p>Add lines showing which episodes and people each observation comes from.</p>
        <p data-scope-description></p>
        <p>Nearby themes share source discussions. Distance does not measure agreement.</p>
      </div></details><button type="button" data-fullscreen aria-pressed="false" aria-controls="graph-stage" aria-label="Enter fullscreen" title="Enter fullscreen"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path data-expand-icon d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/><path data-collapse-icon d="M3 8h5V3m8 0v5h5M8 21v-5H3m13 5v-5h5"/></svg></button><button type="button" data-overview aria-label="Return to overview" title="Return to overview"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7M5 9v12h5v-7h4v7h5V9"/></svg></button><div><button type="button" data-zoom="1.35" aria-label="Zoom in">+</button><button type="button" data-zoom="0.74" aria-label="Zoom out">−</button></div></div>
        <div class="explorer-tooltip" data-tooltip hidden></div>
      </div>
      <aside class="explorer-detail" data-explorer-detail role="dialog" aria-modal="false" aria-labelledby="explorer-detail-title" hidden>
        <div class="explorer-detail-actions"><button type="button" data-back>← Back</button><button type="button" data-close aria-label="Close details">×</button></div>
        <div data-detail-content></div>
      </aside>
    </div>
    <span class="visually-hidden" role="status" aria-live="polite" data-explorer-status></span>
    <SharedIdeaReview coverage={coverage} />
    <KnowledgeMix {topics} {classified} {totalWords} />
    <noscript><style>#explorer-index[hidden]{display:block!important}.explorer-stage,.explorer-tools,.explorer-concepts{display:none}</style><p>Browse the archive above. Enable JavaScript to explore the interactive map.</p></noscript>
  </section>
</BaseLayout>
<script id="knowledge-data" type="application/json" is:inline set:html={serialise(model)}></script>
<script id="topic-membership" type="application/json" is:inline set:html={serialise(membership)}></script>
<script>
import { initialiseExplorer } from '../lib/graph-explorer';
initialiseExplorer();
</script>
<style is:global>
.explorer-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-block:2.5rem 2rem}.explorer-heading .eyebrow{margin:0 0 1rem}.explorer-heading h1{font:500 clamp(3rem,5.5vw,5.5rem)/.95 var(--font-display);letter-spacing:var(--tracking-hero);margin:0}.explorer-heading>p{font-size:var(--type-body);color:var(--text-secondary);margin:0;line-height:1.5}
.explorer{padding-bottom:3rem}.explorer [hidden]{display:none!important}.explorer-bar{border-block:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:.65rem}.explorer-search{display:flex;align-items:center;gap:.8rem;flex:1;max-width:34rem}.explorer-search>span{font-size:1.7rem}.explorer-search input{width:100%;min-width:0;padding:.7rem 0;border:0;border-radius:0;background:transparent;font:400 1rem var(--font-body);color:var(--ink)}.explorer-bar-actions{display:flex;align-items:center;gap:1.5rem}.explorer-bar .text-link{font-size:.7rem;min-height:44px;display:flex;align-items:center;white-space:nowrap}
