---
import {createHash} from 'node:crypto';
import {readFileSync} from 'node:fs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { canonicalPublicGraph } from '@/lib/public-graph-data';
import { buildKnowledgeModel, buildTopicModel } from '@/lib/graph-model';
const rendererVersion=createHash('sha256').update(readFileSync('public/graph-explorer.js')).digest('hex').slice(0,16);
const data = canonicalPublicGraph();
const raw = buildKnowledgeModel(data);
const model = { nodes:raw.nodes, allConnections:raw.links.map((link:any,index:number)=>({id:`public:${index}`,sourceId:link.source,targetId:link.target,relationshipType:link.type,explanation:link.note||'',reviewMethod:link.reviewMethod,reviewer:link.reviewer,reviewedAt:link.reviewedAt,reviewedRelationshipId:link.reviewedRelationshipId})),totals:{knowledge:data.knowledge.nodes.length},focus:null,explicitFocus:false,selectImmediately:true,hideCount:true,reconciliationCoverage:data.reconciliationCoverage||null,archiveReconciliation:Boolean(data.relationshipRegistry) };
const topics = buildTopicModel(data);
const membership = Object.fromEntries(topics.map((topic:any) => { const ids = new Set([topic.id,...topic.children.map((child:any)=>child.id)]); return [topic.id,[...new Set(data.topicIndex.passages.filter((passage:any)=>ids.has(passage.primaryTopicId)).map((passage:any)=>passage.episodeId))]]; }));
const analyses=data.topicIndex.analyses;
const classified=analyses.reduce((sum:number,item:any)=>sum+item.classifiedWordCount,0);
const totalWords=analyses.reduce((sum:number,item:any)=>sum+item.totalWordCount,0);
const episodes=raw.nodes.filter((node:any)=>node.kind==='episode');
const colours: Record<string,string> = {root:'#343b37',host:'#4f78a8',episode:'#72817a',contributor:'#a26f49',concept:'#4aa8a5',claim:'#d96b45',example:'#d49a32',question:'#9674cf',snack:'#d65f87',canonical:'#1e7069'};
const kinds=[...new Set(raw.nodes.map((node:any)=>node.kind))];
const serialise=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
const jsonLd={'@context':'https://schema.org','@type':'CollectionPage',name:'The Intelligence Snacks Graph',url:new URL('/graph/',Astro.site).href};
---
<BaseLayout title="Graph — Intelligence Snacks" description="Search the archive, follow connections across episodes, and inspect the evidence behind each idea." active="graph" {jsonLd}>
<header class="archive-head graph-head page-shell"><p class="eyebrow">The living archive</p><h1>Follow the ideas.</h1><p>Explore the connections, then follow an idea back to its source.</p></header>
<section class="graph-page page-shell">
  <div class="graph-toolbar">
    <div class="graph-views" role="group" aria-label="Graph perspective"><button class="text-link" type="button" data-graph-view="ideas" aria-pressed="true">Ideas</button><button class="text-link" type="button" data-graph-view="episodes" aria-pressed="false">Episodes</button></div>
    <div class="graph-options"><label class="filter-control" data-ideas-controls><span>Idea scope</span><select data-idea-scope><option value="all">Across the archive</option><option value="pilot">Reviewed pilot clusters</option></select></label><label class="filter-control"><span>Map density</span><select data-density aria-label="Map density"><option value="320">Balanced · 320 nodes</option><option value="1000000" selected>All nodes</option></select></label></div>
  </div>
  <div class="graph-layout">
    <div class="graph-map"><div class="graph-map-actions"><div><button class="text-link" type="button" data-reset>Archive overview</button><button class="text-link" type="button" data-motion>Freeze layout</button><button class="text-link" type="button" data-details-toggle aria-controls="graph-detail" aria-expanded="false">Show details</button><button class="text-link" type="button" data-expand>Expand graph</button></div><span class="card-meta" data-view-count></span></div><ul class="graph-key" aria-label="Map node types">{kinds.map((kind)=><li data-kind-key={kind}><i style={`background:${colours[kind]}`} aria-hidden="true"></i>{kind}</li>)}</ul><div class="public-graph" role="region" data-public-graph data-renderer-url={`/graph-explorer.js?v=${rendererVersion}`} aria-label="Visual map; all nodes are also available in the archive list"></div><p class="graph-connectivity" data-connectivity-count role="status"></p><p class="graph-description" data-view-help></p><p class="graph-help">Hover for a title. Select an idea for its connections and source evidence. Zoom to explore a group.</p></div>
    <aside id="graph-detail" class="graph-detail" data-detail aria-labelledby="graph-detail-title"><h2 id="graph-detail-title">Explore a connection</h2><p>Select an idea from the archive list or map. Search includes every published node, including ideas outside the current map.</p></aside>
  </div>
  <details class="graph-discoveries" data-ideas-only><summary data-discovery-toggle>Shared ideas &amp; recent discussions <span aria-hidden="true">↗</span></summary><div class="idea-discovery" data-idea-discovery></div></details>
  <section aria-labelledby="archive-list-title" class="archive-list section"><div class="section-heading"><h2 id="archive-list-title">Archive index</h2><p>Search every published idea, episode and Snack.</p></div>
  <form class="graph-filters" aria-label="Filter the archive index" role="search" onsubmit="return false">
    <label class="search-field"><span class="visually-hidden">Search the archive</span><input type="search" name="q" data-search placeholder="Idea, person, or Snack" autocomplete="off" /></label>
    <label class="filter-control"><span>Type</span><select data-kind><option value="">All types</option>{kinds.map((kind)=><option value={kind}>{kind}</option>)}</select></label>
    <label class="filter-control"><span>Episode</span><select data-episode><option value="">All episodes</option>{episodes.map((episode:any)=><option value={episode.episodeId}>Episode {episode.episodeNumber}</option>)}</select></label>
    <label class="filter-control"><span>Topic</span><select data-topic><option value="">All topics</option>{topics.map((topic:any)=><option value={topic.id}>{topic.name}</option>)}</select></label>
  </form>
  <p role="status" aria-live="polite" data-result-count>{raw.nodes.length} searchable nodes · {raw.links.length} connections</p>
<ul data-results>{raw.nodes.map((node:any)=><li data-result={node.id} data-kind={node.kind} data-episode={node.episodeId}><a class="search-result" href={node.href||'/graph/'} data-node={node.id}><span class="search-result__type">{node.kind}{node.episodeNumber?` · Episode ${node.episodeNumber}`:''}</span><strong>{node.title}</strong><span class="search-result__description">{node.summary}</span><span class="search-result__arrow" aria-hidden="true">↗</span></a></li>)}</ul></section>
  <section class="knowledge-mix section" aria-labelledby="mix-title"><div class="section-heading"><h2 id="mix-title">Knowledge mix</h2></div><p>Share of classified transcript words by primary topic. {totalWords?((classified/totalWords)*100).toFixed(1):'0'}% of transcript words are classified ({classified.toLocaleString()} of {totalWords.toLocaleString()}); secondary tags do not add to these percentages. Word share is not speaking time or importance.</p>{topics.map((topic:any)=><details><summary>{topic.name} · {(topic.share*100).toFixed(1)}%</summary><p>{topic.description}</p><button class="text-link" type="button" data-topic-pick={topic.id}>Explore this topic in the archive</button>{topic.children.map((child:any)=><div class="topic-child"><h3>{child.name} · {(child.share*100).toFixed(1)}% of this family</h3><p>{child.description}</p><ul>{child.episodes.map((episode:any)=><li><a href={episode.href}>Episode {episode.number} · {episode.title}</a></li>)}</ul></div>)}</details>)}</section>
</section>
</BaseLayout>
<script id="knowledge-data" type="application/json" is:inline set:html={serialise(model)}></script>
<script id="topic-membership" type="application/json" is:inline set:html={serialise(membership)}></script>
<script>
import { initialiseGraphPage } from '../lib/graph-page';
initialiseGraphPage();
</script>
<style is:global>
.archive-head.graph-head{min-height:0;padding-block:clamp(2.5rem,5vw,4rem)}
.graph-page{padding-block:2rem 0}.graph-page [hidden]{display:none!important}
.graph-toolbar,.graph-map-actions{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;flex-wrap:wrap}
.graph-views,.graph-options,.graph-map-actions>div{display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap}
.graph-views button.text-link{font-family:var(--font-display);font-size:1rem;letter-spacing:var(--tracking-body);text-transform:none;min-height:3.5rem;padding:0;border-bottom:2px solid transparent}
.graph-views button[aria-pressed="true"]{border-bottom-color:var(--ink)}
.graph-options{gap:.6rem}.graph-description{margin:1rem 0 1.5rem;color:var(--text-secondary);font-size:var(--type-label)}
.graph-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:2rem}.graph-layout.has-details{grid-template-columns:minmax(0,1fr) 340px}
.graph-map,.graph-detail{min-width:0}.graph-map-actions{padding-block:.5rem;border-top:1px solid var(--line)}
.graph-map-actions .text-link{padding:0;min-height:44px;margin:0;letter-spacing:.03em}.graph-map-actions>div{gap:1.25rem}
.graph-map-actions .card-meta{margin:0;font-size:.65rem;line-height:1.5;letter-spacing:0}
.graph-key{display:flex;flex-wrap:wrap;list-style:none;gap:.5rem 1rem;padding:0;margin:.6rem 0 1rem;color:var(--text-secondary);font:var(--type-label)/1.4 var(--font-mono)}
.graph-key li{display:flex;align-items:center;gap:.4rem}.graph-key i{width:.5rem;height:.5rem;border-radius:50%}
.public-graph{position:relative;height:680px;overflow:hidden;background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius-small)}
.sigmaCanvas{position:absolute;inset:0}.sigmaControls{position:absolute;bottom:1rem;right:1rem;display:flex;gap:.25rem}
.sigmaControls button{width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--line);border-radius:var(--radius-small);background:var(--paper);color:var(--ink);font:500 1.1rem/1 var(--font-display);cursor:pointer}
.sigmaControls button:hover{background:var(--ink);color:var(--paper)}
.graph-connectivity,.graph-help{font-size:var(--type-label);color:var(--text-secondary);line-height:1.6}.graph-connectivity{margin:.8rem 0 .25rem}.graph-help{margin:0}
.graph-detail{max-height:850px;overflow:auto;border-left:1px solid var(--line);padding-left:1.5rem}.graph-detail h2{font-size:var(--type-card);line-height:var(--leading-display);letter-spacing:var(--tracking-display)}
.graph-detail h3{font-size:1.25rem;margin-top:2rem}.graph-detail p,.graph-detail li{font-size:.9rem;line-height:1.6}.graph-detail blockquote{margin:1.5rem 0;padding-left:1rem;border-left:2px solid var(--coral)}
.graph-detail ul{padding-left:1rem}.graph-detail li{padding-block:.75rem;border-bottom:1px solid var(--line)}.graph-detail a{text-decoration:underline;text-underline-offset:.2em;overflow-wrap:anywhere}.edge-type{text-transform:uppercase;display:block;font:var(--type-label)/1.5 var(--font-mono);color:var(--text-muted);margin-bottom:.4rem}
.graph-layout:fullscreen{background:var(--paper);padding:1rem;overflow:auto}.graph-layout:fullscreen .public-graph{height:calc(100dvh - 200px);min-height:420px}.graph-layout.is-expanded .public-graph{height:85vh}
.graph-discoveries{margin-top:2rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding-block:1.5rem}.graph-discoveries>summary{display:flex;justify-content:space-between;cursor:pointer;list-style:none;font-family:var(--font-display);font-size:1.25rem}.graph-discoveries>summary::-webkit-details-marker{display:none}
.idea-discovery{display:grid;grid-template-columns:1fr 1fr;gap:3rem;padding-top:2rem}.idea-discovery h2{font-size:var(--type-card);line-height:var(--leading-display);letter-spacing:var(--tracking-display)}.idea-discovery p{font-size:var(--type-label);color:var(--text-secondary);line-height:1.6}.idea-discovery .search-result{grid-template-columns:1fr 1.5rem;gap:.5rem;padding:1rem 0}.idea-discovery .search-result strong{grid-column:1;font-size:1.25rem}.idea-discovery .search-result__type{grid-column:1}.idea-discovery .search-result__description{grid-column:1;font-size:.8rem}.idea-discovery .search-result__arrow{grid-column:2;grid-row:1 / span 3}
.graph-filters{display:grid;grid-template-columns:2fr repeat(3,minmax(0,1fr));gap:1rem;align-items:end}.graph-filters .filter-control{min-width:0}.graph-filters .search-field{min-width:0}.graph-filters .search-field input{font-size:1.15rem;padding:1rem 0;min-height:3.5rem}
.archive-list>ul{list-style:none;margin:1.5rem 0 0;padding:0;max-height:650px;overflow:auto}.archive-list li{margin:0}.archive-list [data-result-count]{font:var(--type-label)/1.5 var(--font-mono);color:var(--text-muted);margin-top:1rem}
.knowledge-mix details{border-top:1px solid var(--line);padding:1.25rem 0}.knowledge-mix summary{cursor:pointer;font-family:var(--font-display)}.knowledge-mix>p{max-width:52rem;color:var(--text-secondary)}.topic-child{padding:1rem 0 0 1rem}.topic-child h3{font-size:1.25rem}
@media(max-width:900px){.graph-layout,.graph-layout.has-details{grid-template-columns:1fr}.graph-detail{border-left:0;border-top:1px solid var(--line);padding:1.5rem 0;max-height:none}.graph-filters{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.graph-toolbar{gap:1rem}.graph-views{gap:1.5rem}.graph-views button.text-link{min-height:44px}.graph-options{width:100%}.graph-options .filter-control{flex:1;min-width:0}.graph-map-actions{gap:.5rem}.graph-map-actions>div{display:grid;grid-template-columns:repeat(2,max-content);gap:0 1.5rem}.graph-map-actions .text-link{font-size:.65rem}.public-graph{height:460px}.idea-discovery{grid-template-columns:1fr;gap:2rem}.graph-filters{grid-template-columns:1fr}.graph-connectivity{font-size:.72rem}}
</style>
