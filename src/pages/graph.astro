.explorer-stage.has-selection{grid-template-columns:minmax(0,1fr)}.explorer-detail{min-width:0;max-height:clamp(480px,73dvh,920px);overflow:auto;border-left:1px solid var(--line);padding:1.25rem 0 1.5rem 1.5rem;background:var(--paper)}.explorer-detail-actions{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.75rem}.explorer-detail-actions button{border:0;padding:0 .5rem}.explorer-detail-actions [data-close]{font-size:1.6rem}.explorer-detail h2{font:500 2rem/1.05 var(--font-display);letter-spacing:var(--tracking-display);margin:.8rem 0 1rem;overflow-wrap:anywhere}.explorer-detail h2:focus{outline:none}.explorer-detail h3{font:500 1.2rem var(--font-display);margin:1.8rem 0 .6rem}.explorer-detail p{font-size:.9rem;line-height:1.6}.explorer-detail .detail-summary{font-size:1rem}.explorer-detail .detail-actions{display:flex;gap:1.2rem;align-items:center;flex-wrap:wrap;padding:1rem 0;border-block:1px solid var(--line)}.explorer-detail .text-link{font-size:.65rem;min-height:44px}.explorer-detail .connection-list{list-style:none;padding:0;margin:0}.connection-list li{border-bottom:1px solid var(--line);padding:.9rem 0}.connection-list button{display:block;background:none;border:0;text-align:left;padding:0;color:var(--ink);font:500 1rem/1.35 var(--font-display);cursor:pointer;text-decoration:underline;text-underline-offset:3px}.connection-list .eyebrow{display:block;font-size:.6rem;margin:0 0 .5rem;color:var(--text-muted)}.connection-list p{font-size:.8rem;margin:.5rem 0 0}.explorer-detail blockquote{border-left:2px solid var(--coral);padding-left:1rem;margin:1.2rem 0;font-size:.9rem;line-height:1.65}.explorer-detail blockquote cite{display:block;font-style:normal;font-size:.75rem;color:var(--text-muted);margin:.6rem 0}.explorer-detail a{overflow-wrap:anywhere}.explorer-detail blockquote a{font-size:.8rem;text-decoration:underline}.explorer-footnote{display:flex;justify-content:space-between;gap:2rem;padding-block:.75rem;color:var(--text-muted);font:400 .65rem/1.6 var(--font-mono)}.explorer-footnote p{margin:0;max-width:49rem}.explorer-footnote>span{white-space:nowrap}.explorer-index{padding-top:2rem}.explorer-index>ul{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:0 2.5rem;max-height:min(360px,45dvh);overflow:auto}.explorer-index li>a{position:relative;display:flex;flex-direction:column;gap:.6rem;padding:1.4rem 2rem 1.4rem 0;border-top:1px solid var(--line);text-decoration:none}.explorer-index strong{font:500 1.4rem/1.15 var(--font-display);letter-spacing:var(--tracking-display)}.explorer-index li>a>span:nth-last-child(2){color:var(--text-secondary);font-size:.85rem;line-height:1.5}.explorer-index li>a>span:last-child{position:absolute;right:.25rem;top:1.4rem}.explorer-index .eyebrow{font-size:.6rem}.explorer button:focus-visible,.explorer a:focus-visible,.explorer input:focus-visible{outline:2px solid var(--coral);outline-offset:3px}
