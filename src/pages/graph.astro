---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { canonicalPublicGraph } from '@/lib/public-graph-data';
import { buildKnowledgeModel, buildTopicModel } from '@/lib/graph-model';
const data = canonicalPublicGraph();
const raw = buildKnowledgeModel(data);
const model = { nodes:raw.nodes, allConnections:raw.links.map((link:any,index:number)=>({id:`public:${index}`,sourceId:link.source,targetId:link.target,relationshipType:link.type,explanation:link.note||''})),totals:{knowledge:data.knowledge.nodes.length},focus:null,explicitFocus:false,selectImmediately:true };
const topics = buildTopicModel(data);
const membership = Object.fromEntries(topics.map((topic:any) => { const ids = new Set([topic.id,...topic.children.map((child:any)=>child.id)]); return [topic.id,[...new Set(data.topicIndex.passages.filter((passage:any)=>ids.has(passage.primaryTopicId)).map((passage:any)=>passage.episodeId))]]; }));
const analyses=data.topicIndex.analyses;
const classified=analyses.reduce((sum:number,item:any)=>sum+item.classifiedWordCount,0);
const totalWords=analyses.reduce((sum:number,item:any)=>sum+item.totalWordCount,0);
const episodes=raw.nodes.filter((node:any)=>node.kind==='episode');
const colours: Record<string,string> = {root:'#343b37',host:'#4f78a8',episode:'#72817a',contributor:'#a26f49',concept:'#4aa8a5',claim:'#d96b45',example:'#d49a32',question:'#9674cf',snack:'#d65f87',canonical:'#1e7069'};
const kinds=[...new Set(raw.nodes.map((node:any)=>node.kind))];
const serialise=(value:unknown)=>JSON.stringify(value).replace(/</g,'\\u003c');
const jsonLd={'@context':'https://schema.org','@type':'CollectionPage',name:'The Intelligence Snacks Graph',url:new URL('/graph/',Astro.site).href};
---
<BaseLayout title="Graph — Intelligence Snacks" description="Search the archive, follow connections across episodes, and inspect the evidence behind each idea." active="graph" {jsonLd}>
<section class="graph-page page-shell">
  <header><p class="eyebrow">The living archive</p><h1>Follow the ideas.</h1><p>Find an idea, follow its connections, and read the source. Related discussions retain their own claims and evidence.</p></header>
  <form class="graph-filters" role="search" onsubmit="return false">
    <label>Search the archive<input type="search" name="q" data-search placeholder="Idea, person, or Snack" autocomplete="off" /></label>
    <label>Type<select data-kind><option value="">All types</option>{kinds.map((kind)=><option value={kind}>{kind}</option>)}</select></label>
    <label>Episode<select data-episode><option value="">All episodes</option>{episodes.map((episode:any)=><option value={episode.episodeId}>Episode {episode.episodeNumber}</option>)}</select></label>
    <label>Topic<select data-topic><option value="">All topics</option>{topics.map((topic:any)=><option value={topic.id}>{topic.name}</option>)}</select></label>
  </form>
  <p role="status" aria-live="polite" data-result-count>{raw.nodes.length} searchable nodes · {raw.links.length} connections</p>
  <div class="graph-layout">
    <div class="graph-map"><div class="graph-map-actions"><button type="button" data-reset>Archive overview</button><button type="button" data-motion>Freeze layout</button><span data-view-count></span></div><ul class="graph-key" aria-label="Map node types">{kinds.map((kind)=><li><i style={`background:${colours[kind]}`} aria-hidden="true"></i>{kind}</li>)}</ul><div class="public-graph" role="region" data-public-graph aria-label="Visual map; all nodes are also available in the archive list"></div><p class="graph-help">The overview shows a sample from every episode. Select any archive result to see its connections. Lines are navigational; relationship meanings appear in the details.</p></div>
    <aside class="graph-detail" data-detail aria-labelledby="graph-detail-title"><h2 id="graph-detail-title">Explore a connection</h2><p>Select an idea from the archive list or map. Search includes every published node, including ideas outside the current map.</p></aside>
  </div>
  <section aria-labelledby="archive-list-title" class="archive-list"><h2 id="archive-list-title">Archive index</h2><p>Every node is available here. Links work without the visual map.</p><ul data-results>{raw.nodes.map((node:any)=><li data-result={node.id} data-kind={node.kind} data-episode={node.episodeId}><a href={node.href||'/graph/'} data-node={node.id}><span>{node.kind}{node.episodeNumber?` · Episode ${node.episodeNumber}`:''}</span><strong>{node.title}</strong></a></li>)}</ul></section>
  <section class="knowledge-mix" aria-labelledby="mix-title"><h2 id="mix-title">Knowledge mix</h2><p>Share of classified transcript words by primary topic. {totalWords?((classified/totalWords)*100).toFixed(1):'0'}% of transcript words are classified ({classified.toLocaleString()} of {totalWords.toLocaleString()}); secondary tags do not add to these percentages. Word share is not speaking time or importance.</p>{topics.map((topic:any)=><details><summary>{topic.name} · {(topic.share*100).toFixed(1)}%</summary><p>{topic.description}</p><button type="button" data-topic-pick={topic.id}>Explore this topic in the archive</button>{topic.children.map((child:any)=><div class="topic-child"><h3>{child.name} · {(child.share*100).toFixed(1)}% of this family</h3><p>{child.description}</p><ul>{child.episodes.map((episode:any)=><li><a href={episode.href}>Episode {episode.number} · {episode.title}</a></li>)}</ul></div>)}</details>)}</section>
</section>
</BaseLayout>
<script id="knowledge-data" type="application/json" is:inline set:html={serialise(model)}></script>
<script id="topic-membership" type="application/json" is:inline set:html={serialise(membership)}></script>
<script>
import { initialiseGraphPage } from '../lib/graph-page';
initialiseGraphPage();
</script>
<style is:global>
.graph-page{padding-block:3rem 5rem}.graph-page h1{font-size:clamp(2.5rem,6vw,5rem);line-height:1;letter-spacing:-.05em}.graph-page>header{max-width:52rem}.graph-filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:1rem;margin-top:2rem}.graph-filters label{display:grid;gap:.4rem;font-size:.85rem}.graph-filters input,.graph-filters select{width:100%;min-height:44px;padding:.65rem;border:1px solid var(--line);background:var(--paper);color:var(--ink)}.graph-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:1rem}.graph-map,.graph-detail{min-width:0;border:1px solid var(--line);padding:1rem}.graph-key{display:flex;flex-wrap:wrap;list-style:none;gap:.4rem .8rem;padding:0;font-size:.7rem}.graph-key li{display:flex;align-items:center;gap:.3rem}.graph-key i{width:.6rem;height:.6rem;border-radius:50%}.graph-map-actions{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}.graph-page button{min-height:44px;padding:.6rem .8rem;border:1px solid var(--line);color:var(--ink);background:var(--paper);cursor:pointer}.public-graph{position:relative;height:560px;overflow:hidden;background:#faf9f9}.sigmaCanvas{position:absolute;inset:0}.sigmaControls{position:absolute;bottom:1rem;right:1rem;display:flex;gap:.25rem}.graphVisibleCount{position:absolute;top:0;left:.5rem;right:.5rem;font-size:.7rem;background:#fff;padding:.4rem;pointer-events:none}.graph-help{font-size:.8rem}.graph-detail{max-height:720px;overflow:auto}.graph-detail h2{font-size:1.5rem}.graph-detail blockquote{margin:1rem 0;padding:.6rem .8rem;border-left:3px solid var(--coral);font-size:.9rem}.graph-detail ul{padding-left:1.1rem}.graph-detail li{margin-block:.6rem}.graph-detail a{overflow-wrap:anywhere}.graph-detail .edge-type{display:block;font-size:.75rem;text-transform:uppercase;color:var(--text-secondary)}.archive-list{margin-block:2rem}.archive-list>ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;list-style:none;padding:0;max-height:650px;overflow:auto}.archive-list li{border:1px solid var(--line)}.archive-list a{display:grid;gap:.4rem;padding:.8rem;min-height:80px;text-decoration:none}.archive-list span{font-size:.7rem;color:var(--text-secondary)}.archive-list strong{font-weight:500}.archive-list li[hidden]{display:none}.knowledge-mix details{border-top:1px solid var(--line);padding:1rem 0}.knowledge-mix summary{cursor:pointer}.topic-child{padding:.5rem 1rem}.graph-page :focus-visible{outline:3px solid #fe7141;outline-offset:3px}.graph-page [data-view-count]{font-size:.75rem}.graphRuntimeError{padding:2rem}.graph-detail [data-close]{float:right}@media(max-width:900px){.graph-layout{grid-template-columns:1fr}.graph-detail{max-height:none}.graph-filters{grid-template-columns:1fr 1fr}.archive-list>ul{grid-template-columns:1fr 1fr}}@media(max-width:550px){.graph-filters,.archive-list>ul{grid-template-columns:1fr}.public-graph{height:420px}.graph-page{padding-block:2rem}.graph-detail{padding:.8rem}}@media(prefers-reduced-motion:reduce){.graph-page *{scroll-behavior:auto!important}}
</style>
