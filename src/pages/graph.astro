.explorer-stage:fullscreen .explorer-detail,.explorer-stage.is-fullscreen .explorer-detail{max-height:calc(100% - 2rem);padding:0 1.5rem 1.5rem}.explorer-stage:fullscreen .explorer-map,.explorer-stage.is-fullscreen .explorer-map{height:100%}
