.explorer-concepts.is-expanded>div{flex-wrap:wrap;max-height:22rem;overflow:auto}.explorer-concepts [data-concepts-toggle]{font-size:.65rem;min-height:44px}
.explorer{overflow-anchor:none}.explorer-search input{scroll-margin-top:85px}

.explorer-heading{padding-block:1.75rem 1.25rem}.explorer-heading .eyebrow{display:none}.explorer-heading h1{font-size:clamp(2.5rem,4vw,4rem)}
