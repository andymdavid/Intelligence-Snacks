---
const { active = '' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const links: Array<readonly [string, string]> = [['Latest', '/'], ['Snacks', '/snacks/'], ['Episodes', '/episodes/'], ['Topics', '/topics/'], ['Contributors', '/contributors/']];
const explore: Array<readonly [string, string]> = [['About', '/about/'], ['Graph', '/graph/'], ['Shared ideas', '/ideas/'], ['For agents', '/for-agents/']];
---

<header class:list={['trial-header', { 'trial-header--home': isHome }]}>
  <a class="trial-brand" href="/" aria-label="Intelligence Snacks home">
    <img src="/images/intelligence-snacks-cassette-transparent.webp" alt="" width="192" height="128" fetchpriority="high" />
    <span>Intelligence Snacks</span>
  </a>
  <div class="trial-header-actions"><a class="trial-search" href="/search/" aria-label="Search Intelligence Snacks"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 4.5 4.5" /></svg></a><button class="trial-menu-button" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M2 8h12" /></svg><span>Menu</span></button></div>
</header>

<dialog class="trial-menu" id="site-menu" aria-label="Site navigation">
  <div class="trial-menu-top">
    <a class="trial-brand" href="/" aria-label="Intelligence Snacks home"><img src="/images/intelligence-snacks-cassette-transparent.webp" alt="" width="192" height="128" /><span>Intelligence Snacks</span></a>
    <div class="trial-header-actions"><a class="trial-search" href="/search/" aria-label="Search Intelligence Snacks"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 4.5 4.5" /></svg></a><button class="trial-menu-button" type="button" data-menu-close autofocus><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13" /></svg><span>Close</span></button></div>
  </div>
  <div class="trial-menu-grid">
    <nav class="trial-menu-pages" aria-label="Primary navigation">
      <p class="trial-menu-label">Pages</p>
      {links.map(([label, href]) => <a href={href} aria-current={active === label.toLowerCase() ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="trial-menu-secondary">
      <nav aria-label="Explore"><p class="trial-menu-label">Explore</p>{explore.map(([label, href]) => <a href={href}>{label}</a>)}<button type="button" data-menu-subscribe>Send me snacks ↗</button></nav>
      <nav aria-label="Listen and watch"><p class="trial-menu-label">Listen &amp; watch</p><a href="https://www.youtube.com/@IntelligenceSnacks" rel="external">YouTube ↗</a><a href="https://open.spotify.com/show/5mhoDNtKg1A0j0IZIw0fIv" rel="external">Spotify ↗</a></nav>
    </div>
  </div>
</dialog>

<script>
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (menu && trigger) {
    const close = () => menu.close();
    trigger.addEventListener('click', () => { menu.showModal(); trigger.setAttribute('aria-expanded', 'true'); document.documentElement.classList.add('navigation-open'); });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    menu.addEventListener('click', (event) => { if (event.target === menu) close(); });
    menu.addEventListener('close', () => { trigger.setAttribute('aria-expanded', 'false'); document.documentElement.classList.remove('navigation-open'); trigger.focus(); });
    menu.querySelector('[data-menu-subscribe]')?.addEventListener('click', () => { close(); const signup = document.querySelector<HTMLDialogElement>('[data-signup-modal]'); signup?.showModal(); signup?.querySelector<HTMLInputElement>('input[type=email]')?.focus(); });
  }
</script>

<style>
  .trial-header { height: 58px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-inline: var(--page-pad); position: relative; z-index: 20; background: transparent; color: var(--ink); }
  .trial-header--home { color: #f5f4ef; }
  .trial-brand { display: inline-flex; align-items: center; gap: .7rem; width: max-content; max-width: 100%; font-family: 'Kanit', Arial, sans-serif; font-size: clamp(.9rem, 1.4vw, 1.125rem); font-weight: 500; line-height: 1; letter-spacing: -.025em; text-transform: uppercase; white-space: nowrap; }
  .trial-brand img { width: 3.25rem; height: auto; border-radius: 0; flex: none; }
  .trial-header-actions { display: flex; align-items: center; gap: .75rem; flex: none; }
  .trial-menu-button, .trial-search { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; background: transparent; color: inherit; cursor: pointer; }
  .trial-menu-button { width: 6rem; gap: .5rem; padding: .625rem .75rem; border: 0; border-radius: 0; font: 500 .75rem/1 var(--font-mono); text-transform: uppercase; }
  .trial-menu-button span { display: block; }
  .trial-menu-button svg { width: .75rem; height: .75rem; fill: none; stroke: currentColor; stroke-width: 1.5; flex: none; }
  .trial-search { width: 40px; }
  .trial-search svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .trial-menu { position: fixed; inset: 0 0 auto; width: 100%; max-width: none; max-height: 100dvh; margin: 0; padding: 0 var(--page-pad) clamp(3rem, 6vw, 6rem); border: 0; background: #f1f3f3; color: #0b1017; overflow-y: auto; }
  .trial-menu::backdrop { background: rgba(0,0,0,.45); }
  .trial-menu-top { min-height: 58px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .trial-menu-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 2rem; width: 64%; margin: clamp(3rem, 6vw, 6rem) 0 0 auto; }
  .trial-menu-label { padding-bottom: .65rem; margin: 0 0 1rem; border-bottom: 1px solid currentColor; font-size: .875rem; font-weight: 400; }
  .trial-menu-pages a { display: block; width: fit-content; font: 600 clamp(2rem, 3.4vw, 3.5rem)/1.15 var(--font-body); letter-spacing: -.05em; margin-bottom: .25rem; }
  .trial-menu-secondary { display: grid; align-content: start; gap: 2.75rem; }
  .trial-menu-secondary a, .trial-menu-secondary button { display: block; width: fit-content; padding: 0; border: 0; background: transparent; color: inherit; font: 500 clamp(1rem, 1.6vw, 1.5rem)/1.35 var(--font-body); letter-spacing: -.035em; text-align: left; cursor: pointer; }
  .trial-menu a:hover, .trial-menu button:hover { opacity: .6; }
  @media (max-width: 700px) {
    .trial-menu-pages a { font-size: clamp(1.4rem, 8vw, 2rem); }
    .trial-brand { gap: .4rem; font-size: clamp(.625rem, 3vw, .875rem); }
    .trial-header, .trial-menu-top { gap: .5rem; }
    .trial-header-actions { gap: .25rem; }
    .trial-search { width: 36px; }
    .trial-menu-button { width: 5rem; padding-inline: .5rem; }
    .trial-brand img { width: 2rem; }
    .trial-menu-grid { width: 100%; margin-top: 2rem; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 1rem; }
  }
</style>

<style is:global>
  html.navigation-open { overflow: hidden; }
  body:has(.trial-header--home) { background: #0b1017; }
  body:has(.trial-header--home) main { background: var(--paper); }
</style>
