---
const { active = '' } = Astro.props;
const links: Array<readonly [string, string]> = [
  ['Latest', '/'],
  ['Snacks', '/snacks/'],
  ['Episodes', '/episodes/'],
  ['Topics', '/topics/'],
  ['Contributors', '/contributors/'],
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Intelligence Snacks home">
    <img
      class="wordmark__mark"
      src="/images/intelligence-snacks-logo.webp"
      alt=""
      width="960"
      height="640"
      fetchpriority="high"
      decoding="async"
    />
    <span class="wordmark__text">
      <span>Intelligence</span><span>Snacks</span>
    </span>
  </a>
  <nav class="primary-nav" aria-label="Primary navigation">
    {links.map(([label, href]) => (
      <a href={href} aria-current={active === label.toLowerCase() ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <div class="header-actions">
    <a class="search-link" href="/search/" aria-label="Search Intelligence Snacks">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.25 4.25"></path></svg>
    </a>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {links.map(([label, href]) => <a href={href} aria-current={active === label.toLowerCase() ? 'page' : undefined}>{label}</a>)}
        <button type="button" data-open-signup>Send me snacks <span aria-hidden="true">↗</span></button>
      </nav>
    </details>
    <button class="subscribe-button" type="button" data-open-signup>Send me snacks <span aria-hidden="true">↗</span></button>
  </div>
</header>
