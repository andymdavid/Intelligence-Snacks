---
import type { CollectionEntry } from 'astro:content';
import StoryVisual from './StoryVisual.astro';

interface Props {
  snack: CollectionEntry<'snacks'>;
  topicName: string;
  colour: string;
  index: number;
  variant?: 'standard' | 'wide' | 'list';
}

const { snack, topicName, colour, index, variant = 'standard' } = Astro.props;
---

<article class:list={['snack-card', `snack-card--${variant}`]}>
  {variant !== 'list' && <a class="snack-card__visual" href={`/snacks/${snack.id}/`} tabindex="-1"><StoryVisual label={snack.data.editorialTitle ?? topicName} {colour} {index} compact={variant === 'standard'} /></a>}
  <div class="snack-card__body">
    <div class="card-meta"><a href={`/topics/${snack.data.primaryTopic.id}/`}>{topicName}</a><span>Snack {String(index).padStart(2, '0')}</span></div>
    <h3><a href={`/snacks/${snack.id}/`}>{snack.data.title}</a></h3>
    <p>{snack.data.standfirst}</p>
    <a class="text-link" href={`/snacks/${snack.id}/`}>Read the idea <span>↗</span></a>
  </div>
</article>
